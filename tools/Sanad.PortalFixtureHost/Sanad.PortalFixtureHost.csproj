<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Sanad.PortalFixtureHost</AssemblyName>
    <RootNamespace>Sanad.PortalFixtureHost</RootNamespace>
    <!--
      Bounded test-only Kestrel host for the W5 portal-report fixture pack.

      This project is intentionally absent from Sanad.slnx: it is a local
      tooling artifact, not part of the shipped solution. It references the
      real Sanad.API so it serves the REAL controllers and handlers, and it
      substitutes only the provider-capable seams with explicit, scripted
      local doubles. It never applies migrations, never runs a production
      seeder and never contacts a provider.
    -->
    <NoWarn>$(NoWarn)</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\API\Sanad.API\Sanad.API.csproj" />
  </ItemGroup>
</Project>
