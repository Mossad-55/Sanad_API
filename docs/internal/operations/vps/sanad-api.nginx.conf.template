# sanad-api.nginx.conf — reverse-proxy template (TLS edge for Sanad API)
#
# REVIEWABLE TEMPLATE — adapt hostnames/paths on the target host. Contains no
# secrets. Assumes nginx with stream/http WebSocket support, certbot (or any
# CA) certificates at the paths below, and the API listening on loopback
# http://127.0.0.1:5000 per sanad-api.service.template (single instance).

upstream sanad_api {
    # Single instance only — exactly one server. Do not add more.
    server 127.0.0.1:5000 max_fails=3 fail_timeout=30s;
    keepalive 32;
}

# No query-token / body / header logging: the chat hub authenticates browser
# sockets with `?access_token=`, so the query string must never reach logs.
# This format logs the queryless $uri (never $request) and no headers/body.
log_format sanad_safe '$remote_addr - $remote_user [$time_local] '
                      '"$request_method $uri $server_protocol" $status '
                      '$body_bytes_sent '
                      'rt=$request_time uct=$upstream_connect_time '
                      'urt=$upstream_response_time';

# HTTP: redirect everything to TLS. No API traffic on port 80.
server {
    listen 80;
    listen [::]:80;
    server_name api-staging.__FILL__;

    access_log /var/log/nginx/sanad-api-access.log sanad_safe;
    # Stock nginx errors can include full requests/query tokens. Discard them
    # for this API; use sanitized access metrics and application errors instead.
    error_log /dev/null crit;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api-staging.__FILL__;

    ssl_certificate /etc/letsencrypt/live/api-staging.__FILL__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api-staging.__FILL__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_timeout 10m;

    access_log /var/log/nginx/sanad-api-access.log sanad_safe;
    error_log /dev/null crit;

    # 52 MiB total multipart budget (matches Kestrel limit in the service
    # template and the chat upload contract). Larger bodies get 413 here.
    client_max_body_size 52M;
    client_body_timeout 60s;

    # Idle/streaming timeouts: SSE and Long Polling hold connections open;
    # WebSocket upgrades bypass proxy buffering below.
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    send_timeout 120s;
    keepalive_timeout 60s;

    # Chat Plus realtime hub: WebSocket upgrade + SSE + Long Polling.
    location /hubs/chat {
        proxy_pass http://sanad_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Never forward or log client Authorization content beyond routing;
        # the API reads the bearer token / ?access_token= itself.
        proxy_cache_bypass $http_upgrade;
        proxy_no_cache $http_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Anonymous release evidence + smoke endpoints stay reachable for the
    # deployment verifier (no auth, no secrets in responses):
    #   GET /api/v1/deployment/info
    #   GET /api/v1/lookups/services
    location / {
        proxy_pass http://sanad_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}
