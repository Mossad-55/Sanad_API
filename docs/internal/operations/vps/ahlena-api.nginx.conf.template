# ahlena-api.nginx.conf — reverse-proxy template (public edge for Ahlena API)
#
# REVIEWABLE TEMPLATE — copy to an nginx site file (canonical name
# /etc/nginx/sites-available/ahlena-api, enabled via sites-enabled symlink).
# Contains no secrets. The authorized Staging deployment is plain HTTP on the
# public port 8091 proxying to the API on loopback http://127.0.0.1:5001 per
# ahlena-api.service.template (single instance). No domain name and no TLS
# termination are part of the current authorized target; introducing either
# requires a separate owner order (nothing here invents a domain/certificate).
#
# Keep the public port (8091) and the upstream loopback port (5001) unchanged
# in any adaptation unless the owner names new values.

upstream ahlena_api {
    # Single instance only — exactly one server. Do not add more.
    server 127.0.0.1:5001 max_fails=3 fail_timeout=30s;
    keepalive 32;
}

# No query-token / body / header logging: the chat hub authenticates browser
# sockets with `?access_token=`, so the query string must never reach logs.
# This format logs the queryless $uri (never $request) and no headers/body.
# (The current Staging host uses the stock access log; enabling the sanitized
# format below is recommended hardening, not a requirement of this template.)
log_format ahlena_safe '$remote_addr - $remote_user [$time_local] '
                       '"$request_method $uri $server_protocol" $status '
                       '$body_bytes_sent '
                       'rt=$request_time uct=$upstream_connect_time '
                       'urt=$upstream_response_time';

server {
    listen 8091;
    # server_name stays the host IP for the current authorized target;
    # no domain is invented here.
    server_name __FILL__;

    # Recommended hardening (off in the current deployment):
    # access_log /var/log/nginx/ahlena-api-access.log ahlena_safe;
    # Stock nginx errors can include full requests/query tokens. Discarding
    # them keeps tokens out of logs; use sanitized access metrics and
    # application errors instead.
    # error_log /dev/null crit;

    # 52 MiB total multipart budget (matches Kestrel limit in the service
    # template and the chat upload contract). Larger bodies get 413 here.
    client_max_body_size 52M;
    client_body_timeout 60s;

    # Idle/streaming timeouts: SSE and Long Polling hold connections open;
    # WebSocket upgrades bypass proxy buffering below.
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    send_timeout 120s;
    keepalive_timeout 60s;

    # Chat Plus realtime hub: WebSocket upgrade + SSE + Long Polling.
    location /hubs/chat {
        proxy_pass http://ahlena_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Never forward or log client Authorization content beyond routing;
        # the API reads the bearer token / ?access_token= itself.
        proxy_cache_bypass $http_upgrade;
        proxy_no_cache $http_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Anonymous release evidence + smoke endpoints stay reachable for the
    # deployment verifier (no auth, no secrets in responses):
    #   GET /api/v1/deployment/info
    #   GET /api/v1/lookups/services
    location / {
        proxy_pass http://ahlena_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}
