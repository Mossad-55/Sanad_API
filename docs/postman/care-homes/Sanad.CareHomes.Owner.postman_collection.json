            "url": "{{baseUrl}}/api/v1/care-homes/facilities/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('non-owner role forbidden', () => pm.response.to.have.status(403));"
                ]
              }
