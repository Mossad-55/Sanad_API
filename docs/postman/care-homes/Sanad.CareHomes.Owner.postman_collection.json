    {
      "name": "05. Booking decisions and cancellation",
      "description": "Source-authored HC-TASK-032 booking and HC-036 extension examples. Requires the disposable Development fixture variables below, including an accepted/paid booking for the extension request, and an effective Finance rule. These requests have not been runtime-verified; do not point them at production or reset a database to make them runnable.",
      "item": [
        {
          "name": "List owner booking requests",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{careHomeOwnerJwt}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/care-homes/booking-requests/mine",
            "description": "CareHomeOwnerAccess. Lists paid requests for the owner's facility only."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('owner booking list contract', () => pm.expect([200, 401, 403, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Decide owner booking request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{careHomeOwnerJwt}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accept\": false,\n  \"reason\": \"Capacity unavailable\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/care-homes/booking-requests/mine/{{careHomeBookingId}}/decision",
            "description": "CareHomeOwnerAccess. Accept moves PaidAwaitingDecision to Accepted. Reject requires a reason, moves to RefundPending, and initiates a full refund when a transaction exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('owner decision authored response', () => pm.expect([200, 400, 401, 403, 404, 409, 500]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06. Stay operations",
      "description": "Source-authored HC-034 room/bed assignment, actual facility check-in/out, Family confirmation, Family-submitted dispute, owner operational readback, and Admin dispute resolution. Requires an accepted booking and disposable fixture IDs. Check-out without Family confirmation opens a case immediately; a Family dispute requires a booking owned by that Family with facility check-in recorded. These examples are authored, not runtime evidence.",
      "item": [
        {
          "name": "Assign physical room and bed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{careHomeOwnerJwt}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{inventoryRoomId}}\",\n  \"bedId\": \"{{inventoryBedId}}\"\n}"
            },
