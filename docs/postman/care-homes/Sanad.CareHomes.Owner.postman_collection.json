              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedVersion\": 1,\n  \"draft\": { \"amenities\": [], \"medicalServices\": [] }\n}"
            },
            "url": "{{baseUrl}}/api/v1/care-homes/facilities/mine/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('stale version conflicts', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04. Owner inventory and availability",
      "description": "Owner-managed room types, rooms, beds, maintenance and derived availability. Authored from the current source contract; the additive migration awaits fresh exact-target authorization and these requests have not been executed in Bruno.",
      "item": [
        {
          "name": "Read my inventory",
          "request": {
            "method": "GET",
            "header": [],
