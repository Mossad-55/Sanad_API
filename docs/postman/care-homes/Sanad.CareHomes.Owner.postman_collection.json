          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('inventory read contract', () => pm.expect([200, 401, 403, 404]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('careHomeFacilityVersion', pm.response.json().version);"
                ]
              }
            }
          ]
        },
