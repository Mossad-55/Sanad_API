              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/v1/care-homes/facilities/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('anonymous rejected', () => pm.response.to.have.status(401));"
