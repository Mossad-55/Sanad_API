  "item": [
    {
      "name": "01. Facility onboarding and profile",
      "description": "Owner-scoped draft lifecycle. Login requests use local test fixtures; replace credentials outside local development.",
      "item": [
        {
          "name": "Create facility draft",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/care-homes/facilities"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created or already exists for the one-facility owner rule', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read my facility",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/care-homes/facilities/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('facility is readable', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('careHomeFacilityVersion', pm.response.json().version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Save bilingual profile draft",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedVersion\": {{careHomeFacilityVersion}},\n  \"draft\": {\n    \"arabicName\": \"دار الأمل\",\n    \"englishName\": \"Hope House\",\n    \"arabicDescription\": \"رعاية وإقامة آمنة\",\n    \"englishDescription\": \"Safe care and accommodation\",\n    \"contactName\": \"Test Contact\",\n    \"contactPhone\": \"+201000000011\",\n    \"contactEmail\": \"carehome.owner@test.sanad.local\",\n    \"governorate\": \"Cairo\",\n    \"city\": \"Nasr City\",\n    \"area\": \"District 1\",\n    \"address\": \"1 Example Street\",\n    \"arabicAdmissionConditions\": \"الشروط متاحة عند التواصل\",\n    \"englishAdmissionConditions\": \"Contact us for admission conditions\",\n    \"amenities\": [],\n    \"medicalServices\": []\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/care-homes/facilities/mine/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('draft saved', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('careHomeFacilityVersion', pm.response.json().version); pm.test('English name round-trips', () => pm.expect(pm.response.json().draft.englishName).to.eql('Hope House')); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload operating-license document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "expectedVersion",
                  "value": "{{careHomeFacilityVersion}}",
                  "type": "text"
                },
                {
                  "key": "type",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "expiryDate",
                  "value": "2030-01-01",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/care-homes/facilities/mine/documents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('document is stored pending review', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.test('document starts pending', () => pm.expect(pm.response.json().status).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read back uploaded document metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/care-homes/facilities/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('document metadata is readable by its owner', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('careHomeFacilityVersion', pm.response.json().version); pm.test('license is pending review', () => pm.expect(pm.response.json().documents.some(d => d.type === 1 && d.status === 1)).to.eql(true)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload private gallery image",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "expectedVersion",
                  "value": "{{careHomeFacilityVersion}}",
                  "type": "text"
                },
                {
                  "key": "kind",
                  "value": "2",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{careHomeProfileImagePath}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/care-homes/facilities/mine/media",
            "description": "Choose a local JPG/PNG no larger than 5 MB in careHomeProfileImagePath. Draft media stays private until the revision is approved."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('private profile image upload succeeds', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const media = pm.response.json(); pm.collectionVariables.set('careHomeProfileMediaId', media.id); pm.test('gallery image metadata is returned', () => { pm.expect(media.kind).to.eql(2); pm.expect(media.contentType).to.be.oneOf(['image/jpeg', 'image/png']); pm.expect(media.length).to.be.at.most(5242880); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Read back private gallery metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/care-homes/facilities/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('owner can read uploaded gallery metadata', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const body = pm.response.json(); pm.collectionVariables.set('careHomeFacilityVersion', body.version); pm.test('uploaded media is present in owner profile', () => pm.expect(body.profileMedia.some(m => m.id === pm.collectionVariables.get('careHomeProfileMediaId'))).to.eql(true)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove private gallery image",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/care-homes/facilities/mine/media/{{careHomeProfileMediaId}}?expectedVersion={{careHomeFacilityVersion}}"
          },
          "description": "State-changing example: use a newly uploaded image and the current facility version."
        },
        {
          "name": "Read owner profile media file",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/care-homes/facilities/mine/media/{{careHomeProfileMediaId}}/file",
            "description": "Private owner readback for a media item belonging to this facility. Returns image bytes; missing or foreign media returns 404. Requires CareHomeOwnerAccess."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('owner media readback contract', () => pm.expect([200, 401, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Submit and resubmit",
      "description": "Authored submission contract. Run after the owner has saved all required bilingual fields and uploaded all four private documents; the current disposable fixture has not yet been executed for this delta.",
      "item": [
        {
          "name": "Submit application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedVersion\": {{careHomeFacilityVersion}}\n}"
            },
            "url": "{{baseUrl}}/api/v1/care-homes/facilities/mine/submit",
            "description": "Owner-only state change. Validates the bilingual profile and four required documents, freezes the submitted revision, and enters PendingReview. Expected errors: 409 CareHomes.Facility.InvalidSubmission for incomplete requirements or 409 CareHomes.Facility.Conflict for stale/non-editable versions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('submission contract response', () => pm.expect([200, 400, 401, 403, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) { pm.test('application is pending review', () => pm.expect(pm.response.json().status).to.eql(2)); pm.collectionVariables.set('careHomeFacilityVersion', pm.response.json().version); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03. Ownership and authorization",
      "item": [
