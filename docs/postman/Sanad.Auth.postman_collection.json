  },
  "item": [
    {
      "name": "Registration",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Anonymous. Family=1, MedicalCaregiver=2, CompanionCaregiver=3. Elderly=4 is rejected.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"arabicFullName\": \"محمد أحمد\",\n  \"englishFullName\": \"Mohamed Ahmed\",\n  \"email\": \"{{email}}\",\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"password\": \"{{password}}\",\n  \"accountType\": {{accountType}},\n  \"avatarUrl\": null\n}"
            }
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/register" },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"userId\": \"018f0000-0000-7000-8000-000000000001\",\n  \"emailVerificationRequestId\": \"018f0000-0000-7000-8000-000000000002\",\n  \"phoneVerificationRequestId\": \"018f0000-0000-7000-8000-000000000003\"\n}"
            },
