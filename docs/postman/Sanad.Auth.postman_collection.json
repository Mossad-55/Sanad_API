            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/elderly/verify-otp",
            "description": "Anonymous. Invalid/unknown/expired use one generic 401.",
