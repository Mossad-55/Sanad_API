    {
      "name": "Elderly SMS login",
      "item": [
        {
          "name": "Request Elderly OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/elderly/request-otp",
            "description": "Anonymous. Always 204 for unknown, ineligible, and eligible phones.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}"
            }
          },
          "response": [
            {
              "name": "204 Eligible or unknown",
              "status": "No Content",
              "code": 204,
              "_postman_previewlanguage": "text",
              "body": ""
            },
            {
              "name": "400 Validation failed",
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\n  \"type\": \"https://httpstatuses.com/400\",\n  \"title\": \"Validation Failed\",\n  \"status\": 400,\n  \"detail\": \"One or more validation errors occurred.\",\n  \"instance\": \"/api/v1/auth/elderly/request-otp\",\n  \"code\": \"Api.Validation.Failed\",\n  \"traceId\": \"00-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-bbbbbbbbbbbbbbbb-00\",\n  \"errors\": {\n    \"PhoneNumber\": [\"Phone number must use E.164 format.\"]\n  }\n}"
            }
