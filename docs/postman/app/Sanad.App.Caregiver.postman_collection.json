    {
      "name": "05. Certificates & Documents",
      "item": [
        {
          "name": "Add certificate (multipart: Practice License)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/certificates",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "type",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "expiryDate",
                  "value": "2028-12-31",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const cert = (body.certificates || []).find(c => c.type === 1);",
                  "  if (cert && cert.id) { pm.environment.set('certificateId', cert.id); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Add certificate (multipart: Graduation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/certificates",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "type",
                  "value": "2",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Replace certificate file (multipart)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/certificates/{{certificateId}}/file",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "expiryDate",
                  "value": "2029-01-01",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Remove (additional) certificate",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/certificates/{{certificateId}}"
          }
        }
      ],
      "description": "Pick a PDF/image file for the file field in each multipart request. Max 5 MB. Practice License type=1, Graduation type=2, Additional type=3."
    },
    {
      "name": "06. Submission & Review Status",
      "item": [
