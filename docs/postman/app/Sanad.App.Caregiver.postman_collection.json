              },
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/submit",
            "body": {
              "mode": "raw",
              "raw": ""
            }
          }
        }
      ],
      "description": "After submit, an admin verifies certificates and approves in the Admin collection > Caregiver review."
    },
    {
      "name": "07. Booking Actions",
      "item": [
        {
          "name": "List bookings (Upcoming)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/bookings?tab=1"
          }
        },
        {
          "name": "List bookings (Past — cancellations)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/bookings?tab=3"
          }
        },
        {
          "name": "Booking detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Accept booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/bookings/{{bookingId}}/accept"
          },
          "description": "Only from PendingCaregiverApproval and before the acceptance deadline."
        },
        {
          "name": "Decline booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/bookings/{{bookingId}}/decline",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"عدم توفر الموعد\"\n}"
            }
          }
        },
        {
          "name": "Start visit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/bookings/{{bookingId}}/start"
          }
        },
        {
          "name": "Cancel accepted booking (manual/lifecycle)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ caregiverToken }}" }],
            "body": { "mode": "raw", "raw": "{\n  \"reasonCategory\": 1,\n  \"reason\": \"Caregiver cannot attend\"\n}" },
            "url": "{{baseUrl}}/api/v1/caregiver/bookings/{{bookingId}}/cancel"
          },
          "description": "Manual one-shot lifecycle mutation. Confirmed requires valid reasonCategory and non-blank reason; 204 success, 400 invalid reason, 404 foreign/unknown booking, 409 policy/state conflict. Use only an approved pre-start confirmed fixture; refund behavior is policy-controlled."
        },
        {
          "name": "Complete visit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/bookings/{{bookingId}}/complete",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caregiverNotes\": \"الحالة العامة جيدة، تم إعطاء الدواء في موعده.\"\n}"
            }
          }
        },
        {
          "name": "Submit visit report (manual/lifecycle)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ caregiverToken }}" }],
            "body": { "mode": "raw", "raw": "{\n  \"observedCondition\": \"Alert and comfortable.\",\n  \"activities\": \"Assisted with exercises.\",\n  \"notes\": \"Follow up.\",\n  \"assessment\": 2\n}" },
            "url": "{{baseUrl}}/api/v1/caregiver/bookings/{{bookingId}}/visit-report"
          },
          "description": "Manual one-shot mutation after the assigned visit is completed. 201 created; 400 invalid/blank content, 404 ownership, 409 already submitted or invalid state."
        },
        {
          "name": "Submit medical report (manual multipart/lifecycle)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{ caregiverToken }}" }],
            "body": { "mode": "formdata", "formdata": [
              { "key": "report", "type": "text", "value": "{\"notes\":\"Stable\",\"assessment\":2,\"photoConsentConfirmed\":false,\"measurementTakenOnUtc\":\"2026-09-20T10:00:00Z\"}" },
              { "key": "photo", "type": "file", "src": [], "value": "" }
            ] },
            "url": "{{baseUrl}}/api/v1/caregiver/bookings/{{bookingId}}/medical-report"
          },
          "description": "Medical caregiver only. The report field is JSON; photo is optional and must be included only with photoConsentConfirmed=true. Manual one-shot completed-booking mutation; 201, 400 invalid content, 403 caregiver type/consent, 404 ownership, 409 duplicate/state."
        },
        {
          "name": "Get medical report photo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ caregiverToken }}" }],
            "url": "{{baseUrl}}/api/v1/caregiver/bookings/medical-reports/{{medicalReportId}}/photo"
          },
          "description": "Safe inline private-image read by the submitting caregiver. 200 image, 401 unauthenticated, 403 unauthorized, 404 missing report/photo."
        }
      ]
    },
    {
      "name": "08. Privacy & Security",
      "item": [
        {
          "name": "Get privacy preferences",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{caregiverToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/caregiver/privacy",
            "description": "200 { showProfile, showRating, showPhone, shareLocation }. Family JWT → bare 403, unauth → 401. Defaults: showProfile true, showRating true, showPhone false, shareLocation false."
          }
        },
        {
          "name": "Update privacy preferences",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{caregiverToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showProfile\": true,\n  \"showRating\": true,\n  \"showPhone\": false,\n  \"shareLocation\": false\n}"
            },
            "url": "{{baseUrl}}/api/v1/caregiver/privacy",
            "description": "204 on success. Full replace, all 4 bools required. showProfile=false hides from discovery search (GET /api/v1/caregivers). Other toggles stored-only for now (rating = Phase I, phone not exposed anywhere yet, location = Phase G)."
          }
        },
        {
          "name": "Get Privacy Policy (signed-in)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/legal/privacy-policy"
          },
          "description": "SET-12 dedicated legal content — legal pages are NOT splash screens. The audience is derived from the JWT; there is no audience parameter. 200 with the current Published version (bilingual sections, version, publication metadata), 404 Cms.Legal.NotPublished when nothing is published for this audience, 401 unauthenticated."
        },
        {
          "name": "Get Terms & Conditions (signed-in)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/legal/terms"
          },
          "description": "SET-12. Same audience and status rules as the privacy-policy route; never falls back to another audience or document type."
        },
        {
          "name": "Get Help Center (FAQs + support contact)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/help-center"
          },
          "description": "SET-13 read surface. Returns only active FAQs for the caller audience (ordered by displayOrder) plus the one global support contact card. 200 with faqs [] and supportContact null before any CMS seeding. Read-only: sends no SMS/email; the support ticket POST /api/v1/support/contact is unchanged."
        },
        {
          "name": "List device sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/sessions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const first = body.sessions && body.sessions[0];",
                  "  if (first && first.deviceSessionId && first.deviceSessionId.value) { pm.environment.set('sessionId', first.deviceSessionId.value); }",
                  "}"
                ]
              }
            }
          ],
          "description": "Non-revoked, non-expired sessions only; no token hashes. Maximum five active sessions per account."
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{caregiverPassword}}\",\n  \"newPassword\": \"NewPassword1234\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/password/change"
          },
          "description": "204 revokes EVERY session, including the current one — log in again before running the logout requests below. 401 Identity.Password.InvalidCurrentPassword · 400 Identity.Password.NewPasswordMustDiffer · 404 Identity.Password.UserNotFound."
        },
        {
          "name": "Revoke one session",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/sessions/{{sessionId}}"
          },
          "description": "204, idempotent. Unknown or foreign session → 404 so ownership is never leaked."
        },
        {
          "name": "Log out this device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              },
              {
                "key": "X-Device-Session-Id",
                "value": "{{caregiverDeviceSessionId}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/sessions/logout"
          },
          "description": "204. Missing or invalid header → 400 Api.Auth.InvalidDeviceSessionHeader."
        },
        {
          "name": "Log out all devices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ caregiverToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/sessions/logout-all"
          },
          "description": "204; revokes every non-revoked session of the account."
        }
      ]
    }
  ]
}
