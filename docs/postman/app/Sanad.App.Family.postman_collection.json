            }
          }
        },
        {
          "name": "Update stock inventory & low-stock threshold",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{familyToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stockQuantity\": 90,\n  \"lowStockThreshold\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/family/dependents/{{dependentId}}/medications/{{medicationId}}/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "family",
