              "raw": "{\n  \"name\": \"أوميجا 3 بلس\",\n  \"dosage\": \"1000 ملغ\",\n  \"doseUnit\": \"كبسولة\",\n  \"doseQuantity\": 1,\n  \"doseTimes\": [\n    \"09:00\",\n    \"21:00\"\n  ],\n  \"startDate\": \"2026-09-01\",\n  \"endDate\": \"2026-12-31\",\n  \"instructions\": \"بعد الإفطار والعشاء\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/family/dependents/{{dependentId}}/medications/{{medicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
