            }
          },
          "description": "No price/caregiver-type fields — pricing is server-side (base + 15% platform fee).",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.bookingId) { pm.environment.set('bookingId', body.bookingId); }",
                  "}"
                ]
