{
  "info": {
    "name": "Sanad App — Public",
    "description": "App-facing routes. Splash and active lookups are public. Auth login is included so Family/Caregiver flows can reuse this collection later. The Paymob subscription callback below is a safe/manual fixture template only: it is not an automated provider mutation and must not be replayed without an approved provider payload and valid body hmac.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "03. Paymob webhook (manual fixture only)",
      "item": [
        {
          "name": "CREATED — manual only",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"subscription_data\": {\n    \"id\": \"{{paymobSubscriptionId}}\",\n    \"initial_transaction\": \"{{paymobInitialTransactionId}}\",\n    \"amount_cents\": 29900,\n    \"state\": \"active\",\n    \"next_billing\": \"2026-10-24T10:00:00Z\"\n  },\n  \"trigger_type\": \"CREATED\",\n  \"hmac\": \"{{paymobSubscriptionHmac}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/payments/webhooks/paymob"
          },
          "description": "Safe/manual provider fixture only; this request does not automate provider mutation and has no automated assertions. Replace variables with an approved provider payload and valid HMAC-SHA512 over trigger_type + \"for\" + subscription_data.id; do not replay against shared local, VPS, or production data."
        },
        {
          "name": "Subscription Created — manual only",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"subscription_data\": {\n    \"id\": \"{{paymobSubscriptionId}}\",\n    \"initial_transaction\": \"{{paymobInitialTransactionId}}\",\n    \"amount_cents\": 29900,\n    \"state\": \"active\",\n    \"next_billing\": \"2026-10-24T10:00:00Z\"\n  },\n  \"trigger_type\": \"Subscription Created\",\n  \"hmac\": \"{{paymobSubscriptionHmac}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/payments/webhooks/paymob"
          },
          "description": "Safe/manual provider fixture only; this request does not automate provider mutation and has no automated assertions. Replace variables with an approved provider payload and valid HMAC-SHA512 over trigger_type + \"for\" + subscription_data.id; do not replay against shared local, VPS, or production data."
        },
        {
          "name": "Successful Transaction — manual only",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"paymob_request_id\": \"{{paymobRequestId}}\",\n  \"subscription_data\": {\n    \"id\": \"{{paymobSubscriptionId}}\",\n    \"amount_cents\": 29900,\n    \"state\": \"active\",\n    \"next_billing\": \"2026-10-24T10:00:00Z\"\n  },\n  \"trigger_type\": \"Successful Transaction\",\n  \"hmac\": \"{{paymobSubscriptionHmac}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/payments/webhooks/paymob"
          },
          "description": "Safe/manual renewal fixture only; this request does not automate provider mutation and has no automated assertions. Renewal callbacks require paymob_request_id. Replace variables with an approved provider payload and valid HMAC-SHA512 over trigger_type + \"for\" + subscription_data.id; do not replay against shared local, VPS, or production data."
        },
        {
          "name": "Failed Transaction — manual only",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"paymob_request_id\": \"{{paymobRequestId}}\",\n  \"subscription_data\": {\n    \"id\": \"{{paymobSubscriptionId}}\",\n    \"amount_cents\": 29900,\n    \"state\": \"failed\",\n    \"next_billing\": \"2026-10-24T10:00:00Z\"\n  },\n  \"trigger_type\": \"Failed Transaction\",\n  \"hmac\": \"{{paymobSubscriptionHmac}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/payments/webhooks/paymob"
          },
          "description": "Safe/manual renewal fixture only; this request does not automate provider mutation and has no automated assertions. Renewal callbacks require paymob_request_id. Replace variables with an approved provider payload and valid HMAC-SHA512 over trigger_type + \"for\" + subscription_data.id; do not replay against shared local, VPS, or production data."
        },
        {
          "name": "Failed Overdue Transaction — manual only",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"paymob_request_id\": \"{{paymobRequestId}}\",\n  \"subscription_data\": {\n    \"id\": \"{{paymobSubscriptionId}}\",\n    \"amount_cents\": 29900,\n    \"state\": \"failed\",\n    \"next_billing\": \"2026-10-24T10:00:00Z\"\n  },\n  \"trigger_type\": \"Failed Overdue Transaction\",\n  \"hmac\": \"{{paymobSubscriptionHmac}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/payments/webhooks/paymob"
          },
          "description": "Safe/manual renewal fixture only; this request does not automate provider mutation and has no automated assertions. Renewal callbacks require paymob_request_id. Replace variables with an approved provider payload and valid HMAC-SHA512 over trigger_type + \"for\" + subscription_data.id; do not replay against shared local, VPS, or production data."
        }
      ]
    },
    {
      "name": "01. Splash Screens",
      "item": [
        {
          "name": "Get published splash screens",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/splash-screens",
            "description": "Anonymous. Returns Published screens only, ordered by displayOrder. Empty list is 200 []."
          }
        }
      ]
    },
    {
      "name": "02. Public Lookups",
      "item": [
        {
          "name": "Get active services",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lookups/services",
            "description": "Anonymous. Active services only."
          }
        },
        {
          "name": "Get active languages",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lookups/languages",
            "description": "Anonymous. Active languages only, ordered by code."
          }
        },
        {
          "name": "Get active governorates",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lookups/governorates",
            "description": "Anonymous. Active governorates only."
          }
        },
        {
          "name": "Get active cities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/lookups/cities?governorateId={{governorateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "lookups",
                "cities"
              ],
              "query": [
                {
                  "key": "governorateId",
                  "value": "{{governorateId}}"
                }
              ]
            },
            "description": "Anonymous. Required governorateId. Returns cities where both city and governorate are active."
          }
        },
        {
          "name": "Get active areas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/lookups/areas?cityId={{cityId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "lookups",
                "areas"
              ],
              "query": [
                {
                  "key": "cityId",
                  "value": "{{cityId}}"
                }
              ]
            },
            "description": "Anonymous. Required cityId. Returns areas only when area + city + governorate are all active."
          }
        },
        {
          "name": "Get active specializations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lookups/specializations",
            "description": "Anonymous. Active specializations for both caregiver types; filter client-side by caregiverType (1 Medical, 2 Companion)."
          }
        },
        {
          "name": "Get active professional titles",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lookups/professional-titles",
            "description": "Anonymous. Active Medical professional titles."
          }
        },
        {
          "name": "Get active academic degrees",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lookups/academic-degrees",
            "description": "Anonymous. Active Medical academic degrees."
          }
        },
        {
          "name": "Get note categories & priorities lookup",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/note-categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "note-categories"
              ]
            },
            "description": "App lookup. GET /api/v1/note-categories returns note categories and priorities; no Authorization header is required by the route."
          }
        }
      ]
    }
  ],
  "variable": [
    {"key": "paymobSubscriptionId", "value": "REPLACE_WITH_PROVIDER_SUBSCRIPTION_ID", "type": "string", "description": "Provider subscription_data.id from an approved callback fixture."},
    {"key": "paymobInitialTransactionId", "value": "REPLACE_WITH_INITIAL_TRANSACTION_ID", "type": "string", "description": "Optional subscription_data.initial_transaction; required for an initial CREATED settlement."},
    {"key": "paymobRequestId", "value": "REPLACE_WITH_PROVIDER_REQUEST_ID", "type": "string", "description": "Required for renewal callbacks and used as the durable idempotency/event identity."},
    {"key": "paymobSubscriptionHmac", "value": "REPLACE_WITH_BODY_HMAC", "type": "string", "description": "Lowercase or uppercase HMAC-SHA512 for trigger_type + for + subscription_data.id using Paymob__HmacSecret."}
  ]
}
