{
  "info": {
    "name": "Sanad Admin",
    "description": "Admin CMS. Login as seeded Super Admin first. Splash writes require CmsContent (Normal + SuperAdmin or ContentAdmin).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Super Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) { pm.environment.set('accessToken', body.accessToken); }",
                  "  if (body.refreshToken) { pm.environment.set('refreshToken', body.refreshToken); }",
                  "  if (body.deviceSessionId && body.deviceSessionId.value) { pm.environment.set('deviceSessionId', body.deviceSessionId.value); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"deviceName\": \"{{deviceName}}\",\n  \"devicePlatform\": {{devicePlatform}},\n  \"appVersion\": \"{{appVersion}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Splash screens",
      "item": [
        {
          "name": "Create splash screen",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id && body.id.value) { pm.environment.set('splashScreenId', body.id.value); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"internalName\": \"welcome\",\n  \"arabicTitle\": \"مرحبا\",\n  \"englishTitle\": \"Welcome\",\n  \"arabicDescription\": \"وصف قصير\",\n  \"englishDescription\": \"Short description\",\n  \"arabicButtonText\": \"التالي\",\n  \"englishButtonText\": \"Next\",\n  \"imagePath\": \"splash/welcome.png\",\n  \"backgroundColor\": \"#1A73E8\",\n  \"displayOrder\": 0\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/splash-screens"
          }
        },
        {
          "name": "Update splash screen",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"arabicTitle\": \"مرحبا بكم\",\n  \"englishTitle\": \"Welcome\",\n  \"arabicDescription\": \"وصف محدث\",\n  \"englishDescription\": \"Updated description\",\n  \"arabicButtonText\": \"ابدأ\",\n  \"englishButtonText\": \"Start\",\n  \"imagePath\": \"splash/welcome.png\",\n  \"backgroundColor\": \"#1A73E8\",\n  \"displayOrder\": 0\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/splash-screens/{{splashScreenId}}"
          }
        },
        {
          "name": "Publish splash screen",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/splash-screens/{{splashScreenId}}/publish"
          }
        },
        {
          "name": "Unpublish splash screen",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/splash-screens/{{splashScreenId}}/unpublish"
          }
        },
        {
          "name": "Delete splash screen",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/splash-screens/{{splashScreenId}}"
          }
        }
      ]
    }
  ]
}
