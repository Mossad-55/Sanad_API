{
  "info": {
    "name": "Sanad Admin",
    "description": "Admin CMS. Login as seeded Super Admin first. Splash writes require CmsContent (Normal + SuperAdmin or ContentAdmin).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Super Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) { pm.environment.set('accessToken', body.accessToken); }",
                  "  if (body.refreshToken) { pm.environment.set('refreshToken', body.refreshToken); }",
                  "  if (body.deviceSessionId && body.deviceSessionId.value) { pm.environment.set('deviceSessionId', body.deviceSessionId.value); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"deviceName\": \"{{deviceName}}\",\n  \"devicePlatform\": {{devicePlatform}},\n  \"appVersion\": \"{{appVersion}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Splash screens",
      "item": [
        {
          "name": "Create splash screen",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id && body.id.value) { pm.environment.set('splashScreenId', body.id.value); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "internalName", "type": "text", "value": "welcome" },
                { "key": "arabicTitle", "type": "text", "value": "مرحبا" },
                { "key": "englishTitle", "type": "text", "value": "Welcome" },
                { "key": "arabicDescription", "type": "text", "value": "وصف قصير" },
                { "key": "englishDescription", "type": "text", "value": "Short description" },
                { "key": "arabicButtonText", "type": "text", "value": "التالي" },
                { "key": "englishButtonText", "type": "text", "value": "Next" },
                { "key": "backgroundColor", "type": "text", "value": "#1A73E8" },
                { "key": "displayOrder", "type": "text", "value": "0" },
                { "key": "file", "type": "file", "src": "", "value": "" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/splash-screens"
          }
        },
        {
          "name": "Update splash screen",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "arabicTitle", "type": "text", "value": "مرحبا بكم" },
                { "key": "englishTitle", "type": "text", "value": "Welcome" },
                { "key": "arabicDescription", "type": "text", "value": "وصف محدث" },
                { "key": "englishDescription", "type": "text", "value": "Updated description" },
                { "key": "arabicButtonText", "type": "text", "value": "ابدأ" },
                { "key": "englishButtonText", "type": "text", "value": "Start" },
                { "key": "backgroundColor", "type": "text", "value": "#1A73E8" },
                { "key": "displayOrder", "type": "text", "value": "0" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/splash-screens/{{splashScreenId}}"
          }
        },
        {
          "name": "Publish splash screen",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/splash-screens/{{splashScreenId}}/publish"
          }
        },
        {
          "name": "Unpublish splash screen",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/splash-screens/{{splashScreenId}}/unpublish"
          }
        },
        {
          "name": "Delete splash screen",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/splash-screens/{{splashScreenId}}"
          }
        }
      ]
    }
  ]
}
