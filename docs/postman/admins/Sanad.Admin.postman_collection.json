{
  "info": {
    "name": "Sanad Admin",
    "description": "Admin CMS and Caregiver lookups. Login as the seeded Super Admin first. Splash writes use CmsContent; lookup writes use CaregiversAdmin (both require a Normal token with account_type SuperAdmin or ContentAdmin).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Super Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) { pm.environment.set('accessToken', body.accessToken); }",
                  "  if (body.refreshToken) { pm.environment.set('refreshToken', body.refreshToken); }",
                  "  if (body.deviceSessionId && body.deviceSessionId.value) { pm.environment.set('deviceSessionId', body.deviceSessionId.value); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"deviceName\": \"{{deviceName}}\",\n  \"devicePlatform\": {{devicePlatform}},\n  \"appVersion\": \"{{appVersion}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Splash screens",
      "item": [
        {
          "name": "Create splash screen",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id && body.id.value) { pm.environment.set('splashScreenId', body.id.value); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "internalName", "type": "text", "value": "welcome" },
                { "key": "arabicTitle", "type": "text", "value": "مرحبا" },
                { "key": "englishTitle", "type": "text", "value": "Welcome" },
                { "key": "arabicDescription", "type": "text", "value": "وصف قصير" },
                { "key": "englishDescription", "type": "text", "value": "Short description" },
                { "key": "arabicButtonText", "type": "text", "value": "التالي" },
                { "key": "englishButtonText", "type": "text", "value": "Next" },
                { "key": "backgroundColor", "type": "text", "value": "#1A73E8" },
                { "key": "displayOrder", "type": "text", "value": "0" },
                { "key": "file", "type": "file", "src": [], "value": "" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/splash-screens"
          }
        },
        {
          "name": "Update splash screen",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "arabicTitle", "type": "text", "value": "مرحبا بكم" },
                { "key": "englishTitle", "type": "text", "value": "Welcome" },
                { "key": "arabicDescription", "type": "text", "value": "وصف محدث" },
                { "key": "englishDescription", "type": "text", "value": "Updated description" },
                { "key": "arabicButtonText", "type": "text", "value": "ابدأ" },
                { "key": "englishButtonText", "type": "text", "value": "Start" },
                { "key": "backgroundColor", "type": "text", "value": "#1A73E8" },
                { "key": "displayOrder", "type": "text", "value": "0" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/splash-screens/{{splashScreenId}}"
          }
        },
        {
          "name": "Publish splash screen",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/splash-screens/{{splashScreenId}}/publish"
          }
        },
        {
          "name": "Unpublish splash screen",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/splash-screens/{{splashScreenId}}/unpublish"
          }
        },
        {
          "name": "Delete splash screen",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/splash-screens/{{splashScreenId}}"
          }
        }
      ]
    },
    {
      "name": "Caregiver lookups — services",
      "item": [
        {
          "name": "List all services (admin)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/services"
          }
        },
        {
          "name": "Create service",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id && body.id.value) { pm.environment.set('serviceId', body.id.value); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "arabicName", "type": "text", "value": "طبيب" },
                { "key": "englishName", "type": "text", "value": "Doctor" },
                { "key": "caregiverType", "type": "text", "value": "1" },
                { "key": "isActive", "type": "text", "value": "true" },
                { "key": "file", "type": "file", "src": [], "value": "" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/admin/lookups/services"
          }
        },
        {
          "name": "Rename service",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"arabicName\": \"طبيب ممارس\",\n  \"englishName\": \"Practicing Doctor\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/lookups/services/{{serviceId}}"
          }
        },
        {
          "name": "Deactivate service",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/services/{{serviceId}}/deactivate"
          }
        },
        {
          "name": "Activate service",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/services/{{serviceId}}/activate"
          }
        }
      ]
    },
    {
      "name": "Caregiver lookups — languages & governorates",
      "item": [
        {
          "name": "List all languages (admin)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/languages"
          }
        },
        {
          "name": "Create language",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id && body.id.value) { pm.environment.set('languageId', body.id.value); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"ar\",\n  \"arabicName\": \"العربية\",\n  \"englishName\": \"Arabic\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/lookups/languages"
          }
        },
        {
          "name": "Rename language",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"arabicName\": \"العربية الفصحى\",\n  \"englishName\": \"Modern Standard Arabic\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/lookups/languages/{{languageId}}"
          }
        },
        {
          "name": "Deactivate language",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/languages/{{languageId}}/deactivate"
          }
        },
        {
          "name": "Activate language",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/languages/{{languageId}}/activate"
          }
        },
        {
          "name": "List all governorates (admin)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/governorates"
          }
        },
        {
          "name": "Create governorate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id && body.id.value) { pm.environment.set('governorateId', body.id.value); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"arabicName\": \"البحيرة\",\n  \"englishName\": \"Beheira\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/lookups/governorates"
          }
        },
        {
          "name": "Rename governorate",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"arabicName\": \"البحيرة\",\n  \"englishName\": \"Beheira Governorate\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/lookups/governorates/{{governorateId}}"
          }
        },
        {
          "name": "Deactivate governorate",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/governorates/{{governorateId}}/deactivate"
          }
        },
        {
          "name": "Activate governorate",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/governorates/{{governorateId}}/activate"
          }
        }
      ]
    },
    {
      "name": "Caregiver lookups — cities & areas",
      "item": [
        {
          "name": "List cities of governorate (admin)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/lookups/cities?governorateId={{governorateId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "admin", "lookups", "cities" ],
              "query": [ { "key": "governorateId", "value": "{{governorateId}}" } ]
            }
          }
        },
        {
          "name": "Create city",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id && body.id.value) { pm.environment.set('cityId', body.id.value); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"governorateId\": \"{{governorateId}}\",\n  \"arabicName\": \"دمنهور\",\n  \"englishName\": \"Damanhur\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/lookups/cities"
          }
        },
        {
          "name": "Rename city",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"arabicName\": \"دمنهور\",\n  \"englishName\": \"Damanhur City\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/lookups/cities/{{cityId}}"
          }
        },
        {
          "name": "Deactivate city",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/cities/{{cityId}}/deactivate"
          }
        },
        {
          "name": "Activate city",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/cities/{{cityId}}/activate"
          }
        },
        {
          "name": "List areas of city (admin)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/lookups/areas?cityId={{cityId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "admin", "lookups", "areas" ],
              "query": [ { "key": "cityId", "value": "{{cityId}}" } ]
            }
          }
        },
        {
          "name": "Create area",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id && body.id.value) { pm.environment.set('areaId', body.id.value); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"cityId\": \"{{cityId}}\",\n  \"arabicName\": \"مركز دمنهور\",\n  \"englishName\": \"Damanhur Markaz\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/lookups/areas"
          }
        },
        {
          "name": "Rename area",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"arabicName\": \"مركز دمنهور\",\n  \"englishName\": \"Damanhur Center\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/lookups/areas/{{areaId}}"
          }
        },
        {
          "name": "Deactivate area",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/areas/{{areaId}}/deactivate"
          }
        },
        {
          "name": "Activate area",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": "{{baseUrl}}/api/v1/admin/lookups/areas/{{areaId}}/activate"
          }
        }
      ]
    }
  ]
}
