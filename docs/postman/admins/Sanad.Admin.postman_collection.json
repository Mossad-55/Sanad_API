    {
      "name": "Caregiver review",
      "item": [
        {
          "name": "List caregivers (paged)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ accessToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/caregivers?page=1&pageSize=10"
          }
        },
        {
          "name": "List pending medical caregivers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ accessToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/caregivers?page=1&pageSize=10&status=2&type=1"
          }
        },
        {
          "name": "Caregiver detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ accessToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/caregivers/{{caregiverId}}"
          }
        },
        {
          "name": "Verify certificate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ accessToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/caregivers/{{caregiverId}}/certificates/{{certificateId}}/verify",
            "body": {
              "mode": "raw",
              "raw": ""
            }
          }
        },
        {
          "name": "Reject certificate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ accessToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/caregivers/{{caregiverId}}/certificates/{{certificateId}}/reject",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Document is unclear; please re-upload.\"\n}"
            }
          }
        },
        {
          "name": "Revoke certificate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ accessToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/caregivers/{{caregiverId}}/certificates/{{certificateId}}/revoke",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"License expired or invalid.\"\n}"
            }
          }
        },
        {
          "name": "Request correction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ accessToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/caregivers/{{caregiverId}}/request-correction",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Please add your service areas and re-upload a clear practice license.\"\n}"
            }
          }
        },
        {
          "name": "Approve application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ accessToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/caregivers/{{caregiverId}}/approve",
            "body": {
              "mode": "raw",
              "raw": ""
            }
          }
        },
        {
          "name": "Reject application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ accessToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/caregivers/{{caregiverId}}/reject",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Requirements not met.\"\n}"
            }
          }
        },
        {
          "name": "Suspend caregiver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ accessToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/caregivers/{{caregiverId}}/suspend",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Policy violation.\"\n}"
            }
          }
        },
        {
          "name": "Reactivate caregiver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ accessToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/caregivers/{{caregiverId}}/reactivate",
            "body": {
              "mode": "raw",
              "raw": ""
            }
          }
        },
        {
          "name": "Download certificate file",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ accessToken }}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/caregivers/{{caregiverId}}/certificates/{{certificateId}}/file"
          }
        }
      ],
      "description": "caregiverId/certificateId are captured by the Caregiver onboarding collection. Review order: verify certificates, then approve (or request correction/reject). Suspend/reactivate apply to Active/Suspended caregivers. File download is the only access path to certificate scans."
    }
  ]
}