{
  "info": {
    "name": "Sanad Users",
    "description": "App-facing routes. Splash GET is anonymous. Auth login is included so Family/Caregiver flows can reuse this collection later.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Splash",
      "item": [
        {
          "name": "Get published splash screens",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/splash-screens",
            "description": "Anonymous. Returns Published screens only, ordered by displayOrder. Empty list is 200 []."
          }
        }
      ]
    },
    {
      "name": "Lookups",
      "item": [
        {
          "name": "Get active services",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lookups/services",
            "description": "Anonymous. Active services only. Empty list is 200 []."
          }
        },
                {
          "name": "Get active languages",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lookups/languages",
            "description": "Anonymous. Active languages only."
          }
        },
        {
          "name": "Get active governorates",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lookups/governorates",
            "description": "Anonymous. Active governorates only."
          }
        }
      ]
    }
  ]
}
