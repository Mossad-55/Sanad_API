{
  "info": {
    "name": "Sanad Users",
    "description": "App-facing (anonymous) routes. Splash and active lookups are public. Auth login is included so Family/Caregiver flows can reuse this collection later.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Splash",
      "item": [
        {
          "name": "Get published splash screens",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/splash-screens",
            "description": "Anonymous. Returns Published screens only, ordered by displayOrder. Empty list is 200 []."
          }
        }
      ]
    },
    {
      "name": "Lookups",
      "item": [
        {
          "name": "Get active services",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lookups/services",
            "description": "Anonymous. Active services only. Empty list is 200 []."
          }
        },
        {
          "name": "Get active languages",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lookups/languages",
            "description": "Anonymous. Active languages only, ordered by code."
          }
        },
        {
          "name": "Get active governorates",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lookups/governorates",
            "description": "Anonymous. Active governorates only, ordered by English name."
          }
        },
        {
          "name": "Get active cities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/lookups/cities?governorateId={{governorateId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "lookups", "cities" ],
              "query": [ { "key": "governorateId", "value": "{{governorateId}}" } ]
            },
            "description": "Anonymous. Required governorateId. Returns cities where both city and governorate are active."
          }
        },
        {
          "name": "Get active areas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/lookups/areas?cityId={{cityId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "lookups", "areas" ],
              "query": [ { "key": "cityId", "value": "{{cityId}}" } ]
            },
            "description": "Anonymous. Required cityId. Returns areas only when area + city + governorate are all active."
          }
        }
      ]
    }
  ]
}
