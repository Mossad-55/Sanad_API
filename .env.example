# Sanad API — local environment template (TRACKED, KEYS ONLY, ZERO SECRETS).
# Copy to `.env` on the target host and fill real values there. `.env` is
# git-ignored and must never be committed, printed, or pasted anywhere.
# See docs/operations/deploy-runbook.md for the production rules.

# --- Runtime ---
DOTNET_ENVIRONMENT=Development
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5235

# --- Databases (per-module keys fall back to IdentityDatabase) ---
ConnectionStrings__IdentityDatabase=Host=localhost;Port=5432;Database=SanadBrunoTestDb;Username=__FILL__;Password=__FILL__
ConnectionStrings__CmsDatabase=
ConnectionStrings__CaregiversDatabase=
ConnectionStrings__FamiliesDatabase=
ConnectionStrings__NotificationsDatabase=
ConnectionStrings__CommunityDatabase=
ConnectionStrings__FinanceDatabase=
ConnectionStrings__CareHomesDatabase=
ConnectionStrings__ChatDatabase=

# --- Fixture seeder (Development disposable targets only; false everywhere else) ---
App__TestUserSeed__Enabled=false
App__TestUserSeed__RunId=
App__TestUserSeed__Password=
App__TestUserSeed__ElderlyPassword=

# --- Bootstrapping admin (first start only; rotate/remove afterwards) ---
Identity__AdminSeed__ArabicFullName=
Identity__AdminSeed__EnglishFullName=
Identity__AdminSeed__Email=
Identity__AdminSeed__PhoneNumber=
Identity__AdminSeed__Password=

# --- Providers (blank = disabled; no calls leave the machine) ---
Paymob__HmacSecret=
Paymob__SecretKey=
Identity__Sms__SmsMisr__Username=
Identity__Sms__SmsMisr__Password=
Identity__Sms__SmsMisr__Sender=
Identity__Email__Smtp__Host=
Identity__Email__Smtp__Port=587
Identity__Email__Smtp__Username=
Identity__Email__Smtp__Password=
Identity__Email__Smtp__FromAddress=

# --- Finance startup migrations (automatic outside Development regardless) ---
FinanceMigrations__ApplyOnStartup=false
