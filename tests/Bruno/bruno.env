# Bruno Environment File for Sanad API Tests
# Copy this file and update the values as needed

# Authentication token (obtain through login endpoint)
accessToken=your_access_token_here

# Test IDs (replace with actual IDs from your test data)
dependentId=00000000-0000-0000-0000-000000000000
requestId=00000000-0000-0000-0000-000000000000
elderlyId=00000000-0000-0000-0000-000000000000

# Pagination defaults
page=1
pageSize=20

# Filtering options (leave empty for no filter)
actorKey=
actionKey=
needKey=
qualifierKey=
startDate=
endDate=
status=

# Optional: Base URL for the API
# baseUrl=http://localhost:5000