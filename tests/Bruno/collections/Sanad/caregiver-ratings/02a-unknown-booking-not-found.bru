meta {
  name: 02a-unknown-booking-not-found
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/family/caregiver-ratings/bookings/11111111-1111-4111-8111-111111111111
  body: json
  auth: bearer
}

auth:bearer {
  token: {{caregiverRatingsFamilyJwt}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "stars": 5,
    "reviewText": null
  }
}

assert {
  res.status: eq 404
}
