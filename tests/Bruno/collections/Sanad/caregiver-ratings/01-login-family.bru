meta {
  name: 01-login-family
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{familyOwnerEmail}}",
    "password": "{{familyOwnerPassword}}",
    "deviceName": "bruno-caregiver-ratings-family",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.body.accessType !== 1 && res.body.accessType !== "Normal") throw new Error("Expected a normal Family-access token; verify the seeded fixture account before running the stateful cases.");
  bru.setVar("caregiverRatingsFamilyJwt", res.body.accessToken);
}
