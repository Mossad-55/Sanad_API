meta {
  name: 05-cancel-missing-sos
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/api/v1/elderly/sos/00000000-0000-4000-8000-000000000001/cancel
  body: none
  auth: bearer
}
auth:bearer {
  token: {{elderlySosCancelJwt}}
}
assert {
  res.status: eq 404
  res.body.code: eq Families.Sos.NotFound
}
