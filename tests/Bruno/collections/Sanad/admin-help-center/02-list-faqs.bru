meta {
  name: 02-list-faqs
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/help-center/faqs?audience=1&isActive=false
  auth: bearer
}

auth:bearer {
  token: {{adminHelpCenterJwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (!Array.isArray(res.body) || !res.body.some(faq => (faq.id && (faq.id.value || faq.id)) === bru.getVar("adminHelpFaqId"))) {
    throw new Error("Filtered FAQ list did not include the newly created inactive FAQ.");
  }
}
