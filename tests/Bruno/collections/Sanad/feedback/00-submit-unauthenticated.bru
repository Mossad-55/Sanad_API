meta {
  name: 00-submit-unauthenticated
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/feedback/app-rating
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "rating": 5, "comment": "Fixture-only unauthenticated request" }
}

assert {
  res.status: eq 401
}
