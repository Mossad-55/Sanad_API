meta {
  name: 05-put-identity-document-first-upload
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/auth/identity-document
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{authImageOwnerJwt}}
}

body:multipart-form {
  front: @file(disposable-upload-fixture.png) @contentType(image/png)
  back: @file(disposable-upload-fixture.png) @contentType(image/png)
}

assert {
  res.status: eq 200
  res.body.uploaded: eq true
}
