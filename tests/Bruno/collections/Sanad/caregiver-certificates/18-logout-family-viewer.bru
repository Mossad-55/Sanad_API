meta {
  name: 18-logout-family-viewer
  type: http
  seq: 18
}
post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout
  body: none
  auth: bearer
}
headers {
  X-Device-Session-Id: {{caregiverCertificatesViewerSessionId}}
}
auth:bearer {
  token: {{caregiverCertificatesViewerJwt}}
}
assert {
