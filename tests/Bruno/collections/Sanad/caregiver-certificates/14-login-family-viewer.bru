meta {
  name: 14-login-family-viewer
  type: http
  seq: 14
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  { "email": "{{viewerEmail}}", "password": "{{viewerPassword}}", "deviceName": "bruno-caregiver-certificates-viewer", "devicePlatform": 3, "appVersion": "1.0.0" }
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("caregiverCertificatesViewerJwt", res.body.accessToken);
  bru.setVar("caregiverCertificatesViewerSessionId", res.body.deviceSessionId.value);
}
