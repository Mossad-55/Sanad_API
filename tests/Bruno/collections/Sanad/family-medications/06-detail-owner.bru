meta {
  name: 06-detail-owner
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/family/dependents/{{familyMedicationDependentId}}/medications/{{familyMedicationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{familyMedicationJwt}}
}

assert {
  res.status: eq 200
  res.body.id: isNotEmpty
}
