meta {
  name: 04-profile-unknown-id
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/caregivers/00000000-0000-0000-0000-000000000001
  body: none
  auth: bearer
}

auth:bearer {
  token: {{caregiverDiscoveryJwt}}
}

assert {
  res.status: eq 404
  res.body.code: eq Caregivers.Discovery.CaregiverNotFound
}
