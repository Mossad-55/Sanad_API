meta {
  name: 04-create-room
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/api/v1/care-homes/inventory/mine/rooms
  body: json
  auth: bearer
}
auth:bearer {
  token: {{inventoryOwnerJwt}}
}
headers {
  Content-Type: application/json
}
body:json {
  {"expectedVersion":{{inventoryVersion}},"roomTypeId":"{{inventoryRoomTypeId}}","roomNumber":"BRUNO-020-{{inventoryRunSuffix}}"}
}
assert {
  res.status: eq 200
}
script:post-response {
  const expectedNumber = `BRUNO-020-${bru.getVar("inventoryRunSuffix")}`;
  const room = res.body.rooms.find(item => item.roomNumber === expectedNumber);
  if (!room) throw new Error("The newly-created unique inventory room was not returned.");
  bru.setVar("inventoryRoomId", room.id); bru.setVar("inventoryVersion", res.body.version);
}
