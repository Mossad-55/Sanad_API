meta {
  name: 10-login-support-admin
  type: http
  seq: 17
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {"email":"support.admin@test.sanad.local","password":"Test-1234!","deviceName":"bruno-care-homes-inventory-admin","devicePlatform":3,"appVersion":"1.0.0"}
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("inventoryAdminJwt", res.body.accessToken); bru.setVar("inventoryAdminSessionId", res.body.deviceSessionId.value);
}
