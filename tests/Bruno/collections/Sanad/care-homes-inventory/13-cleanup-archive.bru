meta {
  name: 13-cleanup-archive
  type: http
  seq: 15
}
post {
  url: {{baseUrl}}/api/v1/care-homes/inventory/mine/beds/{{inventoryBedId}}/archive?expectedVersion={{inventoryVersion}}&restore=false
  auth: bearer
}
auth:bearer {
  token: {{inventoryOwnerJwt}}
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("inventoryVersion", res.body.version);
}
