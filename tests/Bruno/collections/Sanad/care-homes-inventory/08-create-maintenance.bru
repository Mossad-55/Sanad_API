meta {
  name: 08-create-maintenance
  type: http
  seq: 11
}
post {
  url: {{baseUrl}}/api/v1/care-homes/inventory/mine/maintenance
  body: json
  auth: bearer
}
auth:bearer {
  token: {{inventoryOwnerJwt}}
}
headers {
  Content-Type: application/json
}
body:json {
  {"expectedVersion":{{inventoryVersion}},"target":2,"targetId":"{{inventoryBedId}}","startDate":"2027-01-10","endDate":"2027-01-12","reason":"Bruno cleanup window"}
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("inventoryVersion", res.body.version);
}
