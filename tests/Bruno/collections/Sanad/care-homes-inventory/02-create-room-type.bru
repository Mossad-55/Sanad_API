meta {
  name: 02-create-room-type
  type: http
  seq: 3
}
post {
  url: {{baseUrl}}/api/v1/care-homes/inventory/mine/room-types
  body: json
  auth: bearer
}
auth:bearer {
  token: {{inventoryOwnerJwt}}
}
headers {
  Content-Type: application/json
}
body:json {
  {"expectedVersion":{{inventoryVersion}},"arabicName":"غرفة اختبار","englishName":"Inventory Test Shared","monthlyPriceEgp":10000,"allocationMode":1,"arabicDescription":"اختبار","englishDescription":"test"}
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("inventoryRoomTypeId", res.body.roomTypes[0].id); bru.setVar("inventoryVersion", res.body.version);
}
