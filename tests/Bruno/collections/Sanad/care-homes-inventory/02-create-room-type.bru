meta {
  name: 02-create-room-type
  type: http
  seq: 3
}
post {
  url: {{baseUrl}}/api/v1/care-homes/inventory/mine/room-types
  body: json
  auth: bearer
}
auth:bearer {
  token: {{inventoryOwnerJwt}}
}
headers {
  Content-Type: application/json
}
body:json {
  {"expectedVersion":{{inventoryVersion}},"arabicName":"غرفة اختبار","englishName":"Inventory Test Shared {{inventoryRunSuffix}}","monthlyPriceEgp":10000,"allocationMode":1,"arabicDescription":"اختبار","englishDescription":"test"}
}
assert {
  res.status: eq 200
}
script:post-response {
  const expectedName = `Inventory Test Shared ${bru.getVar("inventoryRunSuffix")}`;
  const roomType = res.body.roomTypes.find(item => item.englishName === expectedName);
  if (!roomType) throw new Error("The newly-created unique inventory room type was not returned.");
  bru.setVar("inventoryRoomTypeId", roomType.id); bru.setVar("inventoryVersion", res.body.version);
}
