meta {
  name: 06-create-bed
  type: http
  seq: 7
}
post {
  url: {{baseUrl}}/api/v1/care-homes/inventory/mine/beds
  body: json
  auth: bearer
}
auth:bearer {
  token: {{inventoryOwnerJwt}}
}
headers {
  Content-Type: application/json
}
body:json {
  {"expectedVersion":{{inventoryVersion}},"roomId":"{{inventoryRoomId}}","label":"BRUNO-A"}
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("inventoryBedId", res.body.beds[0].id); bru.setVar("inventoryVersion", res.body.version);
}
