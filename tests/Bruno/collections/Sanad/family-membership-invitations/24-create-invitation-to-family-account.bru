meta {
  name: 24-create-invitation-to-family-account
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/v1/family/invitations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerJwt}}
}

headers {
  Content-Type: application/json
}

body:json {
  {"email":"{{caregiverEmail}}","role":3,"relationshipType":6}
}

assert {
  res.status: eq 201
  res.body.invitedEmail: eq {{caregiverEmail}}
}

script:post-response {
  const id = res.body.id && (res.body.id.value || res.body.id);
  if (!id) throw new Error("Invitation response missing ID");
  bru.setVar("coverageInvitationId", id);
}
