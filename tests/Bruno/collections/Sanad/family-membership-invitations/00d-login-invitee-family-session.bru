meta {
  name: 00d-login-invitee-family-session
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"email":"{{caregiverEmail}}","password":"{{caregiverPassword}}","deviceName":"family-invitee-answer","devicePlatform":3,"appVersion":"1.0.0"}
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("inviteeFamilyJwt", res.body.accessToken);
  bru.setVar("inviteeDeviceSessionId", res.body.deviceSessionId.value || res.body.deviceSessionId);
}
