meta {
  name: 00a-login-invitee-caregiver
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"email":"{{caregiverEmail}}","password":"{{caregiverPassword}}","deviceName":"family-invitee-setup","devicePlatform":3,"appVersion":"1.0.0"}
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("inviteeSetupJwt", res.body.accessToken);
}
