meta {
  name: 05-create-disposable-draft
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/legal-documents
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminLegalDocumentsJwt}}
}

headers {
  Content-Type: application/json
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Admin legal-document mutations require the guarded local Development API.");
}

body:json {
  {
    "documentType": 2,
    "audience": 3,
    "sections": [
      {
        "sectionType": 1,
        "displayOrder": 1,
        "arabicTitle": "شروط تجريبية {{adminLegalDocumentsRun}}",
        "englishTitle": "Disposable terms {{adminLegalDocumentsRun}}",
        "arabicDescription": "محتوى تجريبي محلي قابل للحذف.",
        "englishDescription": "Disposable local-only Bruno content.",
        "arabicBullets": null,
        "englishBullets": null
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.documentType: eq 2
  res.body.audience: eq 3
  res.body.version: isNumber
  res.body.status: eq 1
  res.body.sections: isArray
}

script:post-response {
  const id = res.body.id && (res.body.id.value || res.body.id);
  if (!id) throw new Error("Created legal document response did not include an ID.");
  bru.setVar("adminLegalDocumentId", id);
  bru.setVar("adminLegalDocumentCleanupId", id);
  console.log("ADMIN_LEGAL_DOCUMENT_ID=" + id);
}
