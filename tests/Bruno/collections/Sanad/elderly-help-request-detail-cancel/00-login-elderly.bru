meta {
  name: 00-login-elderly
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identifier": "{{elderlyPhone}}",
    "password": "{{elderlyPassword}}",
    "deviceName": "bruno-elderly-help-request-detail-cancel",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("elderlyHelpRequestJwt", res.body.accessToken);
}
