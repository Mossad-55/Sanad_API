meta {
  name: 13-login-family-owner-disposable
  type: http
  seq: 13
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  { "email": "{{familyOwnerEmail}}", "password": "{{familyOwnerPassword}}", "deviceName": "bruno-notification-owner", "devicePlatform": 3, "appVersion": "1.0.0" }
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("notificationOwnerJwt", res.body.accessToken);
}
