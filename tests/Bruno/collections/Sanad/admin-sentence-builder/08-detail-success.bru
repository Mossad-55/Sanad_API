meta {
  name: 08-detail-success
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/admin/sentence-builder/catalog/{{adminSentenceBuilderRevisionOneId}}
  auth: bearer
}

auth:bearer {
  token: {{adminSentenceBuilderJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Sentence Builder coverage requires the guarded local Development API.");
}

assert {
  res.status: eq 200
  res.body.revisionId: eq {{adminSentenceBuilderRevisionOneId}}
  res.body.stableKey: eq {{adminSentenceBuilderKey}}
  res.body.version: eq 1
  res.body.isActive: eq true
}
