meta {
  name: 01-login-owner
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{familyOwnerEmail}}",
    "password": "{{familyOwnerPassword}}",
    "deviceName": "bruno-account-switch",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status !== 200) {
    const body = res.body ?? {};
    console.log("Account-switch login diagnostic:", res.status, body.code ?? body.errorCode ?? body.title ?? body.detail ?? "<no response code>");
    return;
  }
  bru.setVar("jwt", res.body.accessToken);
  const rawSessionId = res.body.deviceSessionId && (res.body.deviceSessionId.value ?? res.body.deviceSessionId);
  if (!rawSessionId) throw new Error("Login response did not contain the device-session ID.");
  bru.setVar("accountSwitchDeviceSessionId", rawSessionId);
}
