meta {
  name: 04-logout-owner
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout-all
  body: none
  auth: bearer
}

headers {
  X-Device-Session-Id: {{positiveQuoteOwnerDeviceSessionId}}
}

auth:bearer {
  token: {{positiveQuoteOwnerJwt}}
}

assert {
  res.status: eq 204
}
