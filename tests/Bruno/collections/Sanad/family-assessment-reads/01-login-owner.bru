meta {
  name: 01-login-owner
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Family assessment catalog coverage requires the guarded local Development API.");
}

body:json {
  {
    "email": "{{familyOwnerEmail}}",
    "password": "{{familyOwnerPassword}}",
    "deviceName": "bruno-family-assessment-reads",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (!res.body.accessToken) throw new Error("Family Owner login did not return an access token.");
  bru.setVar("familyAssessmentReadsJwt", res.body.accessToken);
}
