meta {
  name: 12-read-no-pending-downgrade
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/family/subscriptions/current
  body: none
  auth: bearer
}

headers {
  X-Device-Session-Id: {{familySubscriptionOwnerDeviceSessionId}}
}

auth:bearer {
  token: {{familySubscriptionOwnerJwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const current = res.body && (res.body.currentSubscription ?? res.body.CurrentSubscription);
  const pending = current && (current.pendingDowngrade ?? current.PendingDowngrade);
  const autoRenew = current && (current.autoRenewEnabled ?? current.AutoRenewEnabled);
  if (!current || pending != null || autoRenew !== true) throw new Error("The no-provider downgrade cancellation changed unexpected subscription state.");
}
