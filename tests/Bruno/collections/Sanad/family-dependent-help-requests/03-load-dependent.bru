meta {
  name: 03-load-dependent
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/family/dependents
  auth: bearer
}

auth:bearer {
  token: {{familyHelpJwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const match = res.body.find(item => item.phoneNumber === bru.getEnvVar("elderlyPhone"));
  const id = match && typeof match.id === "object" ? match.id.value : match?.id;
  if (!id) throw new Error("Could not resolve the dependent linked to the Elderly test fixture.");
  bru.setVar("familyHelpDependentId", id);
}
