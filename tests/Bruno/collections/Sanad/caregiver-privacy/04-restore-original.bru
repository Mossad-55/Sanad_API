meta {
  name: 04-restore-original
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/caregiver/privacy
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{caregiverPrivacyJwt}}
}

body:json {
  {
    "showProfile": true,
    "showRating": true,
    "showPhone": false,
    "shareLocation": false
  }
}

assert {
  res.status: eq 204
}
