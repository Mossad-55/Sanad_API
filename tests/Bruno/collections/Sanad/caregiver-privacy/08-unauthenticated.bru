meta {
  name: 08-unauthenticated
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/caregiver/privacy
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "showProfile": true,
    "showRating": true,
    "showPhone": false,
    "shareLocation": false
  }
}

assert {
  res.status: eq 401
}
