meta {
  name: 07-login-companion-caregiver
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Caregiver pricing coverage requires the guarded local Development API.");
}

body:json {
  {
    "email": "{{companionCaregiverEmail}}",
    "password": "{{companionCaregiverPassword}}",
    "deviceName": "bruno-caregiver-pricing-companion",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("caregiverPricingCompanionJwt", res.body.accessToken);
  bru.setVar("caregiverPricingCompanionSessionId", res.body.deviceSessionId.value);
}
