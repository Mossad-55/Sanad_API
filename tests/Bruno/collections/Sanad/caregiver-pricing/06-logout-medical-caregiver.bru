meta {
  name: 06-logout-medical-caregiver
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout
  body: none
  auth: bearer
}

headers {
  X-Device-Session-Id: {{caregiverPricingMedicalSessionId}}
}

auth:bearer {
  token: {{caregiverPricingMedicalJwt}}
}

assert {
  res.status: eq 204
}
