meta {
  name: 06-put-identity-first
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/auth/identity-document
  body: multipart-form
  auth: bearer
}

headers {
  X-Device-Session-Id: {{imageReplacementSessionId}}
}

auth:bearer {
  token: {{imageReplacementJwt}}
}

body:multipart-form {
  front: @file(disposable-upload-fixture.png) @contentType(image/png)
  back: @file(disposable-upload-fixture.png) @contentType(image/png)
}

assert {
  res.status: eq 200
  res.body.uploaded: eq true
}
