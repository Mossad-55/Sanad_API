meta {
  name: 01-create-dependent
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/family/dependents
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{photoOwnerJwt}}
}

body:multipart-form {
  arabicFullName: مرافق اختبار الصور
  englishFullName: Bruno Disposable Photo
  phoneNumber: {{photoFixturePhone}}
  gender: 1
  relationshipType: 7
  dateOfBirth: 1948-07-20
  detailedAddress: Disposable photo fixture
  healthNotes: Temporary photo coverage fixture
}

assert {
  res.status: eq 201
  res.body.englishFullName: eq Bruno Disposable Photo
}

script:pre-request {
  const phone = "+201" + String(Date.now()).slice(-9);
  bru.setVar("photoFixturePhone", phone);
}

script:post-response {
  const id = res.body.id && (res.body.id.value || res.body.id);
  if (!id) throw new Error("Dependent response did not contain an ID");
  bru.setVar("photoDependentId", id);
}
