meta {
  name: 06b-duplicate-plan-change-callback
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/v1/payments/webhooks/paymob
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "obj": {
      "amount_cents": {{positivePlanChangeAmountCents}}, "created_at": "{{positivePlanChangeCreatedAt}}", "currency": "EGP", "error_occured": false, "has_parent_transaction": false, "id": {{positivePlanChangeTransactionId}}, "integration_id": 1, "is_3d_secure": false, "is_auth": false, "is_capture": true, "is_refunded": false, "is_standalone_payment": true, "is_voided": false,
      "order": { "id": {{positivePlanChangeOrderId}}, "merchant_order_id": "{{positivePlanChangeMerchantReference}}" }, "owner": 1, "pending": false, "source_data": { "pan": "", "sub_type": "", "type": "wallet" }, "success": true
    },
    "hmac": "{{positivePlanChangeHmac}}"
  }
}

assert {
  res.status: eq 200
}
