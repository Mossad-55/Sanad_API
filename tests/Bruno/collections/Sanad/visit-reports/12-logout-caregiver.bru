meta {
  name: 12-logout-caregiver
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout
  body: none
  auth: bearer
}

headers {
  X-Device-Session-Id: {{visitReportCaregiverDeviceSessionId}}
}

auth:bearer {
  token: {{visitReportCaregiverJwt}}
}

assert {
  res.status: eq 204
}
