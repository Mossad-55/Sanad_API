meta {
  name: 23-create-malformed-sections
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/admin/wellness-tips
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{wellnessTipsAdminJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Wellness tips mutations require the guarded local Development API.");
}

body:multipart-form {
  arabicTitle: اختبار صيغة أقسام
  englishTitle: Malformed sections
  category: general
  sectionsJson: not-json
  file: @file(service-icon-fixture.png) @contentType(image/png)
}

assert {
  res.status: eq 400
}
