meta {
  name: 33-update-replacement-image
  type: http
  seq: 33
}

put {
  url: {{baseUrl}}/api/v1/admin/wellness-tips/{{wellnessTipId}}
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{wellnessTipsAdminJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Wellness tips mutations require the guarded local Development API.");
}

body:multipart-form {
  arabicTitle: نصيحة برونو محدثة
  englishTitle: Updated Bruno wellness draft
  category: mobility
  sectionsJson: [{"DisplayOrder":1,"ArabicText":"ابدأ بخطوات صغيرة","EnglishText":"Start with small steps"}]
  file: @file(service-icon-fixture.png) @contentType(image/png)
}

assert {
  res.status: eq 200
  res.body.status: eq 1
  res.body.category: eq mobility
}

script:post-response {
  if (!res.body.imagePath) throw new Error("Updated wellness tip response did not include replacement imagePath.");
  if (res.body.imagePath === bru.getVar("wellnessTipOriginalImagePath")) throw new Error("Replacement upload did not produce a new imagePath.");
  bru.setVar("wellnessTipReplacementImagePath", res.body.imagePath);
}
