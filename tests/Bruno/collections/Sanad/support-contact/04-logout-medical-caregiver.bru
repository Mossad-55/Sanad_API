meta {
  name: 04-logout-medical-caregiver
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout
  body: none
  auth: bearer
}

headers {
  X-Device-Session-Id: {{supportContactSessionId}}
}

auth:bearer {
  token: {{supportContactJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Support Contact requires guarded local Development.");
}

assert {
  res.status: eq 204
}
