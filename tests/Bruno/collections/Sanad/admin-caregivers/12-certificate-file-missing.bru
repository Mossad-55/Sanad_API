meta {
  name: 12-certificate-file-missing
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/admin/caregivers/0f000000-0000-4000-8000-000000000001/certificates/0f000000-0000-4000-8000-000000000002/file
