meta {
  name: 05-reject-missing
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/admin/caregivers/0f000000-0000-4000-8000-000000000001/reject
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminCaregiversSuperJwt}}
}

body:json {
  {
    "reason": "Missing caregiver"
  }
}

assert {
  res.status: eq 404
  res.body.code: eq Caregivers.Onboarding.CaregiverNotFound
}
