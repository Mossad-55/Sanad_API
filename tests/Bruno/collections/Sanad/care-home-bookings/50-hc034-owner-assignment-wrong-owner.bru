meta {
  name: 50-hc034-owner-assignment-wrong-owner
  type: http
  seq: 55
}
post {
  url: {{baseUrl}}/api/v1/care-homes/booking-requests/mine/{{hc034OtherFacilityBookingId}}/assignment
  body: json
  auth: bearer
}
auth:bearer {
  token: {{careHomeOwnerJwt}}
}
headers {
  Content-Type: application/json
}
body:json {
  { "roomId": "{{hc034OtherFacilityRoomId}}", "bedId": "{{hc034OtherFacilityBedId}}" }
}
assert {
  res.status: eq 404
  res.body.code: eq CareHomes.Bookings.NotFound
}
