meta {
  name: 08-login-owner
  type: http
  seq: 11
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {
    "email": "{{careHomeOwnerEmail}}",
    "password": "{{careHomeOwnerPassword}}",
    "deviceName": "bruno-care-home-owner",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("careHomeOwnerJwt", res.body.accessToken);
  bru.setVar("careHomeOwnerDeviceSessionId", res.body.deviceSessionId.value);
}
