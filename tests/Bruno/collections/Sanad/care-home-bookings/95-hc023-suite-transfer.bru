meta {
  name: 95-hc023-suite-transfer
  type: http
  seq: 95
}
post {
  url: {{baseUrl}}/api/v1/care-homes/booking-requests/mine/{{hc023SuiteBookingId}}/assignment/transfer
  body: json
  auth: bearer
}
auth:bearer {
  token: {{careHomeOwnerJwt}}
}
headers {
  Content-Type: application/json
}
body:json {
  { "roomId": "{{hc023SuiteDestinationRoomId}}", "bedId": null, "effectiveDate": "{{hc023SuiteTransferDate}}" }
}
assert {
  res.status: eq 200
  res.body.roomTypeId: eq {{hc023SuiteRoomTypeId}}
}
script:post-response {
  
  const hc023ExpectedStatus = 200;   const hc023ExpectedCode = null;   const hc023Body = res.body && typeof res.body === "object" ? res.body : {};   const hc023ActualCode = typeof hc023Body.code === "string" ? hc023Body.code : "";   const hc023TraceId = typeof hc023Body.traceId === "string" ? hc023Body.traceId : "";   const hc023Safe = (value) => value.replace(/[^A-Za-z0-9._:-]/g, "").slice(0, 120);   if (res.status !== hc023ExpectedStatus || (hc023ExpectedCode !== null && hc023ActualCode !== hc023ExpectedCode)) {     console.log(`[HC-023 DIAG] 95-hc023-suite-transfer expectedStatus=${hc023ExpectedStatus} actualStatus=${res.status} expectedCode=${hc023ExpectedCode ?? "<not-asserted>"} actualCode=${hc023Safe(hc023ActualCode) || "<none>"} traceId=${hc023Safe(hc023TraceId) || "<none>"}`);   }
if (res.body.assignedBedId !== null) throw new Error("Suite transfer unexpectedly assigned a bed.");
if (res.status === 200) {
const hc023CairoToday = String(bru.getVar("hc023CairoToday") ?? bru.getEnvVar("hc023CairoToday"));
const hc023Variable = (name) => String(bru.getVar(name) ?? bru.getEnvVar(name));
const hc023EffectiveDate = hc023Variable("hc023SuiteTransferDate");
const hc023ExpectedCurrentRoom = hc023EffectiveDate <= hc023CairoToday ? hc023Variable("hc023SuiteDestinationRoomId") : hc023Variable("hc023SuiteSourceRoomId");
if (String(res.body.assignedRoomId).toLowerCase() !== hc023ExpectedCurrentRoom.toLowerCase()) throw new Error(`Expected current room ${hc023ExpectedCurrentRoom} for effective date ${hc023EffectiveDate} and Cairo date ${hc023CairoToday}.`); }
}
