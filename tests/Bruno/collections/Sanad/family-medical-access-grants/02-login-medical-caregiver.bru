meta {
  name: 02-login-medical-caregiver
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  { "email": "{{caregiverEmail}}", "password": "{{caregiverPassword}}", "deviceName": "bruno-medical-grants-caregiver", "devicePlatform": 3, "appVersion": "1.0.0" }
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("medicalCaregiverUserId", res.body.userId.value);
  bru.setVar("medicalCaregiverJwt", res.body.accessToken);
  bru.setVar("medicalCaregiverSessionId", res.body.deviceSessionId.value);
}
