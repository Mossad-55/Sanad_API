meta {
  name: 04-professional-titles-active
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/lookups/professional-titles
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

script:post-response {
  const rows = res.body;
  if (!Array.isArray(rows) || rows.length === 0 || !rows[0].id?.value) throw new Error("Expected active professional titles with typed IDs.");
}
