meta {
  name: 02-areas-active
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/lookups/areas?cityId={{publicLookupCityId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

script:post-response {
  const rows = res.body;
  if (!Array.isArray(rows) || rows.length === 0 || !rows[0].id?.value) throw new Error("Expected active areas for the first active city.");
}
