meta {
  name: 01-login-superadmin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}",
    "deviceName": "bruno-admin-subscription-lifecycle",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("adminSubscriptionLifecycleJwt", res.body.accessToken);
  bru.setVar("adminSubscriptionLifecycleSessionId", res.body.deviceSessionId.value);
}
