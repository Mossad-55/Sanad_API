meta {
  name: 01-get-current
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/finance/platform-charge-rules/current
  auth: bearer
}

auth:bearer {
  token: {{financeAdminJwt}}
}

assert {
  res.status: eq 200
  res.body.version: eq {{financeChargeRuleVersion}}
  res.body.platformFeeRatePercentage: eq 12.5
  res.body.taxRatePercentage: eq 7.25
}
