meta {
  name: 02-list-dependents
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/family/dependents
  body: none
  auth: bearer
}

auth:bearer {
  token: {{familyCareNotesOwnerJwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const dependents = Array.isArray(res.body) ? res.body : (res.body.items || res.body.results || []);
  const dependentId = dependents.length && typeof dependents[0].id === "object" ? dependents[0].id.value : dependents.length ? dependents[0].id : null;
  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(dependentId))) throw new Error("Expected a seeded Family Owner dependent GUID.");
  bru.setVar("familyCareNotesDependentId", dependentId);
}
