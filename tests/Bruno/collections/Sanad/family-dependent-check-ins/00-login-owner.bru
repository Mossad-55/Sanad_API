meta {
  name: 00-login-owner
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{familyEmail}}",
    "password": "{{familyPassword}}",
    "deviceName": "{{deviceName}}",
    "devicePlatform": {{devicePlatform}},
    "appVersion": "{{appVersion}}"
  }
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
  res.json.accessType: eq "Normal"
  res.json.accountType: eq 1
}