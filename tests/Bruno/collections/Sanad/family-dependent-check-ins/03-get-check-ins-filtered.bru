meta {
  name: 03-get-check-ins-filtered
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/family/dependents/{{dependentId}}/check-ins?page=1&pageSize=10&startDate=2026-09-01&endDate=2026-09-30&answer=true
  auth: bearer
}

assert {
  res.status: eq 200
  res.json.items: is array
  res.json.page: eq 1
  res.json.pageSize: eq 10
  res.json.totalCount: is number
  res.json.items[*]?.answer: eq true
}