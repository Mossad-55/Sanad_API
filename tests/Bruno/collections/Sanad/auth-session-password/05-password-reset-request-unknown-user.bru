meta {
  name: 05-password-reset-request-unknown-user
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/password/reset/request
  body: json
  auth: none
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Auth coverage requires the guarded local Development API.");
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "not-a-user-auth-reset@test.sanad.local"
  }
}

assert {
  res.status: eq 204
}
