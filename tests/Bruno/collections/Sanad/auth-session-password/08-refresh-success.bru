meta {
  name: 08-refresh-success
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Auth coverage requires the guarded local Development API.");
  if (!bru.getVar("authSessionPasswordRefreshToken") || !bru.getVar("authSessionPasswordDeviceSessionId")) throw new Error("Run the SupportAdmin login before refresh.");
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "deviceSessionId": "{{authSessionPasswordDeviceSessionId}}",
    "refreshToken": "{{authSessionPasswordRefreshToken}}"
  }
}

assert {
  res.status: eq 200
  res.body.deviceSessionId.value: isNotEmpty
  res.body.accessToken: isNotEmpty
  res.body.refreshToken: isNotEmpty
}

script:post-response {
  bru.setVar("authSessionPasswordAccessToken", res.body.accessToken);
  bru.setVar("authSessionPasswordRefreshToken", res.body.refreshToken);
}
