meta {
  name: 06-password-reset-unknown-user
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/password/reset
  body: json
  auth: none
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Auth coverage requires the guarded local Development API.");
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "not-a-user-auth-reset@test.sanad.local",
    "otpCode": "123456",
    "newPassword": "New-Test-1234!"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq Identity.Password.UserNotFound
}
