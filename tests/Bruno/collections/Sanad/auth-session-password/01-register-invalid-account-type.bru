meta {
  name: 01-register-invalid-account-type
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Auth coverage requires the guarded local Development API.");
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "arabicFullName": "اختبار ساناد",
    "englishFullName": "Sanad Test",
    "email": "auth-invalid-type@test.sanad.local",
    "phoneNumber": "+201009998888",
    "password": "Test-1234!",
    "accountType": 99
  }
}

assert {
  res.status: eq 400
  res.body.code: eq Api.Validation.Failed
}
