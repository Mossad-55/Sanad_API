meta {
  name: 00-login-caregiver
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "{{companionCaregiverEmail}}", "password": "{{companionCaregiverPassword}}", "deviceName": "bruno-caregiver-earnings", "devicePlatform": 3, "appVersion": "1.0.0" }
}

script:post-response {
  if (!res.body.accessToken) throw new Error("Caregiver login did not return an access token.");
  bru.setVar("jwt", res.body.accessToken);
}

assert {
  res.status: eq 200
}
