meta {
  name: 00-login-owner
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "family.downgrade@test.sanad.local",
    "password": "Test-1234!",
    "deviceName": "bruno-family-manual-downgrade",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("manualDowngradeJwt", res.body.accessToken);
  bru.setVar("manualDowngradeDeviceSessionId", res.body.deviceSessionId.value);
}
