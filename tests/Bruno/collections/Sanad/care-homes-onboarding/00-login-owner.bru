meta {
  name: 00-login-owner
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "carehome.owner@test.sanad.local",
    "password": "Test-1234!",
    "deviceName": "bruno-care-homes-onboarding",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Care homes onboarding requires the guarded local Development API.");
  if (res.body.accessType !== 1 && res.body.accessType !== "Normal") throw new Error("Expected normal owner account access.");
  bru.setVar("careHomeOwnerJwt", res.body.accessToken);
}
