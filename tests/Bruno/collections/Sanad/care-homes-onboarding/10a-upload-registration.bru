meta {
  name: 10a-upload-registration
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/care-homes/facilities/mine/documents
  body: multipartForm
  auth: bearer
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:55819" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Care homes document uploads require the guarded main-worktree Development API.");
}

auth:bearer {
  token: {{careHomeOwnerJwt}}
}

body:multipart-form {
  expectedVersion: {{careHomeFacilityVersion}}
  type: 2
  file: @file(service-icon-fixture.png) @contentType(image/png)
}

assert {
  res.status: eq 200
  res.body.type: eq 2
  res.body.status: eq 1
}

script:post-response {
  bru.setVar("careHomeFacilityVersion", Number(bru.getVar("careHomeFacilityVersion")) + 1);
}
