meta {
  name: 00-login-caregiver
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{caregiverEmail}}",
    "password": "{{caregiverPassword}}",
    "deviceName": "{{deviceName}}",
    "devicePlatform": {{devicePlatform}},
    "appVersion": "{{appVersion}}"
  }
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
  res.json.accessType: eq "Normal"
  // accountType: 2 for MedicalCaregiver, 3 for CompanionCaregiver
  res.json.accountType: in [2, 3]
}