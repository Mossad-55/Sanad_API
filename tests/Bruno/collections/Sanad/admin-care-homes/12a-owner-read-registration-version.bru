meta {
  name: 12a-owner-read-registration-version
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/care-homes/facilities/mine
  auth: bearer
}

auth:bearer {
  token: {{adminCareHomesOwnerJwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status !== 200 || !res.body) throw new Error("Expected registration replacement version readback.");
  bru.setVar("adminCareHomeOwnerVersion", res.body.version);
}
