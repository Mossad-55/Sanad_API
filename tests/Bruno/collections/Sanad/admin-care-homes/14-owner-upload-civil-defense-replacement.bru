meta {
  name: 14-owner-upload-civil-defense-replacement
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/care-homes/facilities/mine/documents
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{adminCareHomesOwnerJwt}}
}

body:multipart-form {
  expectedVersion: {{adminCareHomeOwnerVersion}}
  type: 4
  file: @file(service-icon-fixture.png) @contentType(image/png)
}

assert {
  res.status: eq 200
  res.body.type: eq 4
  res.body.status: eq 1
}

script:post-response {
  if (res.status !== 200 || !res.body) throw new Error("Expected civil-defense replacement upload response.");
  bru.setVar("adminCareHomeOwnerVersion", Number(bru.getVar("adminCareHomeOwnerVersion")) + 1);
}
