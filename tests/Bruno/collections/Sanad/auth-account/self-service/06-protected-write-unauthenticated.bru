meta {
  name: 06-protected-write-unauthenticated
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/account/language
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "uiLanguage": 2
  }
}

assert {
  res.status: eq 401
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") {
    throw new Error("Account auth coverage requires the guarded local Development API.");
  }
}
