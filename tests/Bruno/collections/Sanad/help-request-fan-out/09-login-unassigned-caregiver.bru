meta {
  name: 09-login-unassigned-caregiver
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{companionCaregiverEmail}}",
    "password": "{{companionCaregiverPassword}}",
    "deviceName": "bruno-help-request-fixture",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("helpRequestUnassignedCaregiverJwt", res.body.accessToken);
}
