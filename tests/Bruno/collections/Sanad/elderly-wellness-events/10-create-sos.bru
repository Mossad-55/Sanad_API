meta {
  name: 10-create-sos
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/elderly/sos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{elderlyWellnessJwt}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{elderlyWellnessSosKey}}
}

script:pre-request {
  bru.setVar("elderlyWellnessSosKey", `bruno-elderly-wellness-sos-${Date.now()}`);
}

body:json {
  {
    "locationConsentGranted": true,
    "latitude": null,
    "longitude": null
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (!res.body.id) throw new Error("Expected the created SOS event ID.");
  bru.setVar("elderlyWellnessSosId", res.body.id);
}
