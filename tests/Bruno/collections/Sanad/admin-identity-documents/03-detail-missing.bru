meta {
  name: 03-detail-missing
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/identity-documents/0f000000-0000-4000-8000-000000000001
  auth: bearer
}

auth:bearer {
  token: {{adminIdentityDocumentsContentJwt}}
}

assert {
  res.status: eq 404
  res.body.code: eq Identity.IdentityDocument.UserNotFound
}
