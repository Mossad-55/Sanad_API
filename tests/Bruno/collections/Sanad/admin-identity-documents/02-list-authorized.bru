meta {
  name: 02-list-authorized
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/identity-documents?page=1&pageSize=10
  auth: bearer
}

auth:bearer {
  token: {{adminIdentityDocumentsContentJwt}}
}

assert {
  res.status: eq 200
  res.body.page: eq 1
  res.body.pageSize: eq 10
  res.body.totalCount: isNumber
  res.body.items: isArray
}
