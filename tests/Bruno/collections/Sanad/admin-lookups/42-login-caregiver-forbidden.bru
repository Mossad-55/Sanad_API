meta {
  name: 42-login-caregiver-forbidden
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{caregiverEmail}}",
    "password": "{{caregiverPassword}}",
    "deviceName": "bruno-admin-lookups-viewer",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") {
    throw new Error("Admin lookup authorization coverage requires the guarded local Development API.");
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("adminLookupNonAdminJwt", res.body.accessToken);
}
