meta {
  name: 00-login-medical
  type: http
  seq: 0
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Caregiver schedule coverage requires the guarded local Development API.");
}
body:json {
  { "email": "{{caregiverEmail}}", "password": "{{caregiverPassword}}", "deviceName": "bruno-caregiver-schedules-medical", "devicePlatform": 3, "appVersion": "1.0.0" }
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("scheduleMedicalJwt", res.body.accessToken);
  bru.setVar("scheduleMedicalSessionId", res.body.deviceSessionId.value);
}
