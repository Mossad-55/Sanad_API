meta {
  name: 02-login-companion-caregiver
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "companion.caregiver@test.sanad.local",
    "password": "{{caregiverPassword}}",
    "deviceName": "medical-reports-companion",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("medicalReportCompanionJwt", res.body.accessToken);
}
