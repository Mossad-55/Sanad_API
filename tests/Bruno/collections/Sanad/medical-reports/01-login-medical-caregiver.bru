meta {
  name: 01-login-medical-caregiver
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{caregiverEmail}}",
    "password": "{{caregiverPassword}}",
    "deviceName": "medical-reports",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("medicalReportCaregiverJwt", res.body.accessToken);
  bru.setVar("medicalReportCaregiverDeviceSessionId", res.body.deviceSessionId.value);
}
