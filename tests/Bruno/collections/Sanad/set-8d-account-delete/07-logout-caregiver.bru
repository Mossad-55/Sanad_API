meta {
  name: 07-logout-caregiver
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout
  body: none
  auth: bearer
}

headers {
  X-Device-Session-Id: {{set8dCaregiverSessionId}}
}

auth:bearer {
  token: {{jwt}}
}

script:pre-request {
  const response = await bru.sendRequest({
    method: "GET",
    url: bru.getEnvVar("baseUrl") + "/api/v1/auth/sessions",
    headers: {
      Authorization: "Bearer " + bru.getVar("jwt"),
      Connection: "close"
    }
  });
  const session = response.data.sessions[0];
  bru.setVar("set8dCaregiverSessionId", session.deviceSessionId.value || session.deviceSessionId);
}

assert {
  res.status: eq 204
}
