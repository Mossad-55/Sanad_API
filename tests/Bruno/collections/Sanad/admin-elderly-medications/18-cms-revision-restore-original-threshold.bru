meta {
  name: 18-cms-revision-restore-original-threshold
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/v1/admin/cms/medication-lateness/revisions
  body: json
  auth: bearer
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Medication lateness CMS mutations require the guarded local Development API.");
  if (!bru.getVar("adminMedicationLatenessOriginalRevisionId") || !bru.getVar("adminMedicationLatenessOriginalThreshold")) throw new Error("Original active revision was not captured; refusing to mutate the setting.");
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminMedicationLatenessContentJwt}}
}

body:json {
  {
    "thresholdMinutes": {{adminMedicationLatenessOriginalThreshold}}
  }
}

assert {
  res.status: eq 200
  res.body.thresholdMinutes: eq {{adminMedicationLatenessOriginalThreshold}}
  res.body.isActive: eq true
}

script:post-response {
  const revisionId = res.body.revisionId;
  if (!revisionId || revisionId === bru.getVar("adminMedicationLatenessOriginalRevisionId")) throw new Error("Expected a new restoration revision while preserving the captured original revision.");
  bru.setVar("adminMedicationLatenessRestoreRevisionId", revisionId);
  console.log("ADMIN_MEDICATION_LATENESS_RESTORE_REVISION_ID=" + revisionId);
  console.log("CLEANUP IDS: restoreRevision=" + revisionId + ", testRevision=" + bru.getVar("adminMedicationLatenessCreatedRevisionId") + ", originalRevision=" + bru.getVar("adminMedicationLatenessOriginalRevisionId"));
}
