meta {
  name: 20-logout-all-content-admin
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout-all
  body: none
  auth: bearer
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Fixture-account logout must target the guarded local Development API.");
  if (!bru.getVar("adminMedicationLatenessContentJwt")) throw new Error("ContentAdmin login was not completed; cannot logout the group sessions.");
}

auth:bearer {
  token: {{adminMedicationLatenessContentJwt}}
}

assert {
  res.status: eq 204
}
