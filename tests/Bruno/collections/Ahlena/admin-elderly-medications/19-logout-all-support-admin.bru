meta {
  name: 19-logout-all-support-admin
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout-all
  body: none
  auth: bearer
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Fixture-account logout must target the guarded local Development API.");
  if (!bru.getVar("adminMedicationLatenessSupportJwt")) throw new Error("SupportAdmin login was not completed; cannot logout the group session.");
}

auth:bearer {
  token: {{adminMedicationLatenessSupportJwt}}
}

assert {
  res.status: eq 204
}
