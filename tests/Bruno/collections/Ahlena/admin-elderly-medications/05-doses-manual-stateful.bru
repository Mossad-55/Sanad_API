meta {
  name: 05-doses-manual-stateful
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/admin/elderly/medications/{{brunoAdminMedicationId}}/doses?startDate=2026-09-01&endDate=2026-09-30
  auth: bearer
}

headers {
  X-Correlation-ID: bruno-admin-medication-doses
}

auth:bearer {
  token: {{adminElderlyMedicationJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Admin medication operational reads require the guarded local Development API.");
  if (!bru.getVar("brunoAdminMedicationId")) throw new Error("Run the authorized medication list first to capture a seeded medication ID.");
}

assert {
  res.status: eq 200
  res.body: isArray
}
