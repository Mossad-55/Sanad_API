meta {
  name: 04-create-authorized
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/family/dependents/{{dependentId}}/medical-access-grants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{familyJwt}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "grantType": "Limited", "canViewRecords": true, "canEditRecords": false, "canShareWithOthers": false, "granteeUserId": "{{medicalCaregiverUserId}}", "notes": "Fixture grant" }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("grantId", res.body.id);
}

docs {
  Requires a disposable dependent owned by the authenticated family and no active grant.
}
