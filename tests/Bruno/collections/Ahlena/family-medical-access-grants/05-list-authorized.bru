meta {
  name: 05-list-authorized
  type: http
  seq: 5
}
get {
  url: {{baseUrl}}/api/v1/family/dependents/{{dependentId}}/medical-access-grants?grantId={{grantId}}
  auth: bearer
}
auth:bearer {
  token: {{familyJwt}}
}
assert {
  res.status: eq 200
  res.body[0].id: eq {{grantId}}
  res.body[0].isActive: eq true
}
