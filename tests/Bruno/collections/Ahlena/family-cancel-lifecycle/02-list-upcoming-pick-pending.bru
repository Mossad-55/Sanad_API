meta {
  name: 02-list-upcoming-pick-pending
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/family/bookings?tab=Upcoming
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const items = Array.isArray(res.body)
    ? res.body
    : (res.body && (res.body.items || res.body.results)) || [];
  const statusOf = (it) => it.status ?? it.Status;
  const idOf = (it) => it.id ?? it.Id ?? it.bookingId ?? it.BookingId;
  const isPending = (s) =>
    s === 1 || s === 2 ||
    s === "PendingPayment" || s === "PendingCaregiverApproval" ||
    s === "pendingPayment" || s === "pendingCaregiverApproval";
  const isUnpaidPending = (s) =>
    s === 1 || s === "PendingPayment" || s === "pendingPayment";
  // Prefer an UNPAID PendingPayment target (a paid PendingCaregiverApproval
  // cancel would invoke the sandbox refund call by design).
  const pending = items.find(i => isUnpaidPending(statusOf(i))) ||
                  items.find(i => isPending(statusOf(i)));
  bru.setVar("pendingCancelBookingId", pending ? idOf(pending) : "");
  console.log("upcoming:", items.length,
    "| pending target:", bru.getVar("pendingCancelBookingId") || "NONE");
  if (!pending) {
    console.log("NOTE: this is a one-consumable lifecycle proof - it needs the fresh seed's unpaid pending booking; reseed the dev database, then re-run this folder.");
  }
}
