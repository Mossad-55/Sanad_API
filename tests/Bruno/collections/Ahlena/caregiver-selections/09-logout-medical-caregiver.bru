meta {
  name: 09-logout-medical-caregiver
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout
  body: none
  auth: bearer
}

headers {
  X-Device-Session-Id: {{caregiverSelectionsSessionId}}
}

auth:bearer {
  token: {{caregiverSelectionsJwt}}
}

assert {
  res.status: eq 204
}
