meta {
  name: 03-readback-exact-selections
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/caregiver/profile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{caregiverSelectionsJwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const ids = values => JSON.stringify(values.map(x => x.value ?? x));
  if (ids(res.body.serviceIds) !== bru.getVar("caregiverSelectionServices")) throw new Error("Persisted service set differs from baseline.");
  if (ids(res.body.languageIds) !== bru.getVar("caregiverSelectionLanguages")) throw new Error("Persisted language set differs from baseline.");
  if (ids(res.body.areaIds) !== bru.getVar("caregiverSelectionAreas")) throw new Error("Persisted area set differs from baseline.");
}
