meta {
  name: 04-create-room
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/api/v1/care-homes/inventory/mine/rooms
  body: json
  auth: bearer
}
auth:bearer {
  token: {{inventoryOwnerJwt}}
}
headers {
  Content-Type: application/json
}
body:json {
  {"expectedVersion":{{inventoryVersion}},"roomTypeId":"{{inventoryRoomTypeId}}","roomNumber":"BRUNO-020"}
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("inventoryRoomId", res.body.rooms[0].id); bru.setVar("inventoryVersion", res.body.version);
}
