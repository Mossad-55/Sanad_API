meta {
  name: 16-content-admin-denied
  type: http
  seq: 19
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {"email":"content.admin@test.sanad.local","password":"Test-1234!","deviceName":"bruno-care-homes-inventory-content","devicePlatform":3,"appVersion":"1.0.0"}
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("inventoryContentJwt", res.body.accessToken);
}
