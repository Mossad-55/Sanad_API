meta {
  name: 11-login-moderator
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "{{adminEmail}}", "password": "{{adminPassword}}", "deviceName": "bruno-community-posts-moderator", "devicePlatform": 3, "appVersion": "1.0.0" }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("moderatorJwt", res.body.accessToken);
  bru.setVar("moderatorSessionId", res.body.deviceSessionId.value);
}
