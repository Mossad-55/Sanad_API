meta {
  name: 00-login-caregiver
  type: http
  seq: -1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "{{companionCaregiverEmail}}", "password": "{{companionCaregiverPassword}}", "deviceName": "bruno-community-posts", "devicePlatform": 3, "appVersion": "1.0.0" }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("jwt", res.body.accessToken);
  bru.setVar("communityPostsInitialJwt", res.body.accessToken);
  bru.setVar("communityPostsInitialSessionId", res.body.deviceSessionId.value);
  bru.setVar("communityLocalDate", new Date().toISOString().slice(0, 10));
}
