meta {
  name: 16-rate-authenticated
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/v1/community/posts/{{postId}}/rating
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "ratingValue": "5" }
}

assert {
  res.status: eq 200
}

docs {
  Requires a published post; ratings are scoped to the authenticated user and must be between 1 and 5.
}
