meta {
  name: 13-relogin-caregiver
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "{{companionCaregiverEmail}}", "password": "{{companionCaregiverPassword}}", "deviceName": "bruno-community-posts-member", "devicePlatform": 3, "appVersion": "1.0.0" }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("jwt", res.body.accessToken);
  bru.setVar("communityPostsFinalJwt", res.body.accessToken);
  bru.setVar("communityPostsFinalSessionId", res.body.deviceSessionId.value);
}
