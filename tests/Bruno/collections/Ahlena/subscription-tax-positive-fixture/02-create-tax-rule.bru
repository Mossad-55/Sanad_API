meta {
  name: 02-create-tax-rule
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/subscriptions/tax-rules
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Device-Session-Id: {{subscriptionSuperAdminDeviceSessionId}}
}

auth:bearer {
  token: {{subscriptionSuperAdminJwt}}
}

body:json {
  {
    "ratePercentage": 15,
    "version": 3,
    "effectiveOnUtc": "2026-01-01T00:00:00Z"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status !== 201) throw new Error("Disposable tax-rule creation must return 201.");
  bru.setVar("subscriptionTaxRuleId", res.body);
}
