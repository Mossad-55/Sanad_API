meta {
  name: 08-login-viewer
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{viewerEmail}}",
    "password": "{{viewerPassword}}",
    "deviceName": "bruno-family-medical-profile-viewer",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (!res.body.accessToken) throw new Error("Family Viewer login did not return an access token.");
  bru.setVar("familyMedicalViewerJwt", res.body.accessToken);
}
