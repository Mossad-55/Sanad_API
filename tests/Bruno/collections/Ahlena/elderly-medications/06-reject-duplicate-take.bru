meta {
  name: 06-reject-duplicate-take
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/elderly/medications/{{elderlyMedicationId}}/doses/take
  body: json
  auth: bearer
}

auth:bearer {
  token: {{elderlyMedicationJwt}}
}

body:json {
  {
    "scheduledDate": "{{elderlyMedicationLocalDate}}",
    "scheduledTime": "{{elderlyMedicationScheduledTime}}",
    "notes": "Duplicate test must not decrement twice"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq Families.Medication.DoseAlreadyTaken
}
