meta {
  name: 08-reject-not-scheduled-dose
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/elderly/medications/{{elderlyMedicationId}}/doses/take
  body: json
  auth: bearer
}

auth:bearer {
  token: {{elderlyMedicationJwt}}
}

body:json {
  {
    "scheduledDate": "{{elderlyMedicationLocalDate}}",
    "scheduledTime": "00:00:00",
    "notes": null
  }
}

assert {
  res.status: eq 400
  res.body.code: eq Families.Medication.DoseNotScheduled
}
