meta {
  name: 01-request-otp-registered
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/elderly/request-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  const baseUrl = bru.getEnvVar("baseUrl");
  if (baseUrl !== "http://localhost:5235") throw new Error("OTP dispatch test may run only against the guarded local fixture API.");
  if (bru.getEnvVar("appEnvironment") !== "Development" || bru.getEnvVar("smsSenderMode") !== "development-noop") {
    throw new Error("OTP dispatch test requires the local Development API with its no-op SMS sender.");
  }
}

body:json {
  {
    "phoneNumber": "{{elderlyPhone}}"
  }
}

assert {
  res.status: eq 204
}
