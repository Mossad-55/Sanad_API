meta {
  name: 03-create-coupon
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/admin/subscriptions/coupons
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Device-Session-Id: {{adminSubscriptionLifecycleSessionId}}
}

auth:bearer {
  token: {{adminSubscriptionLifecycleJwt}}
}

body:json {
  {
    "code": "BRUNO-AUDIT-20261001",
    "subscriptionPlanVersionId": "{{adminSubscriptionPremiumV2Id}}",
    "discountPercentage": 10,
    "expiresOnUtc": "2030-01-01T00:00:00Z"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("adminSubscriptionCouponId", res.body);
}
