meta {
  name: 17-list-cities
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/admin/lookups/cities?governorateId={{governorateId}}
  auth: bearer
}

auth:bearer {
  token: {{adminLookupsJwt}}
}

script:post-response {
if (res.status !== 200) throw new Error(`Expected 200, got ${res.status}`);
}
