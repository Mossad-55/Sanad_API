meta {
  name: 04-rename-service
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/admin/lookups/services/{{serviceId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminLookupsJwt}}
}

body:json {
  {
    "arabicName": "غير موجود",
    "englishName": "Missing service"
  }
}

script:post-response {
  if (res.status !== 200) throw new Error(`Expected 200, got ${res.status}`);
}
script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") {
    throw new Error("Admin lookup mutations require the guarded local Development API.");
  }
}
