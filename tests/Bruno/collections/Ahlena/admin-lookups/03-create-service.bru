meta {
  name: 03-create-service
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/admin/lookups/services
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{adminLookupsJwt}}
}

body:multipart-form {
  arabicName: Arabic service {{lookupUnique}}
  englishName: Service {{lookupUnique}}
  caregiverType: 1
  isActive: true
  file: @file(service-icon-fixture.png) @contentType(image/png)
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status !== 201) throw new Error(`Expected 201, got ${res.status}`);
  const id = res.body.id && (res.body.id.value || res.body.id);
  if (!id) throw new Error("Create response did not include a service ID");
  bru.setVar("serviceId", id);
}
script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") {
    throw new Error("Admin lookup mutations require the guarded local Development API.");
  }
}
