meta {
  name: 96-hc023-checked-in-transfer
  type: http
  seq: 96
}
post {
  url: {{baseUrl}}/api/v1/care-homes/booking-requests/mine/{{hc023CheckedInBookingId}}/assignment/transfer
  body: json
  auth: bearer
}
auth:bearer {
  token: {{careHomeOwnerJwt}}
}
headers {
  Content-Type: application/json
}
body:json {
  { "roomId": "{{hc023CheckedInDestinationRoomId}}", "bedId": null, "effectiveDate": "{{hc023CheckedInTransferDate}}" }
}
assert {
  res.status: eq 200
  res.body.assignedRoomId: eq {{hc023CheckedInDestinationRoomId}}
  res.body.actualCheckInOnUtc: isNotEmpty
}
script:post-response {
  const hc023ExpectedStatus = 200;   const hc023ExpectedCode = null;   const hc023Body = res.body && typeof res.body === "object" ? res.body : {};   const hc023ActualCode = typeof hc023Body.code === "string" ? hc023Body.code : "";   const hc023TraceId = typeof hc023Body.traceId === "string" ? hc023Body.traceId : "";   const hc023Safe = (value) => value.replace(/[^A-Za-z0-9._:-]/g, "").slice(0, 120);   if (res.status !== hc023ExpectedStatus || (hc023ExpectedCode !== null && hc023ActualCode !== hc023ExpectedCode)) {     console.log(`[HC-023 DIAG] 96-hc023-checked-in-transfer expectedStatus=${hc023ExpectedStatus} actualStatus=${res.status} expectedCode=${hc023ExpectedCode ?? "<not-asserted>"} actualCode=${hc023Safe(hc023ActualCode) || "<none>"} traceId=${hc023Safe(hc023TraceId) || "<none>"}`);   }
}
