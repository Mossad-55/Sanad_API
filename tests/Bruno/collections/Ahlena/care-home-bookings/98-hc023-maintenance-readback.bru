meta {
  name: 98-hc023-maintenance-readback
  type: http
  seq: 98
}
get {
  url: {{baseUrl}}/api/v1/care-homes/inventory/mine
  body: none
  auth: bearer
}
auth:bearer {
  token: {{careHomeOwnerJwt}}
}
assert {
  res.status: eq 200
  res.body.maintenance: isNotEmpty
}
script:post-response {
  
  const hc023ExpectedStatus = 200;   const hc023ExpectedCode = null;   const hc023Body = res.body && typeof res.body === "object" ? res.body : {};   const hc023ActualCode = typeof hc023Body.code === "string" ? hc023Body.code : "";   const hc023TraceId = typeof hc023Body.traceId === "string" ? hc023Body.traceId : "";   const hc023Safe = (value) => value.replace(/[^A-Za-z0-9._:-]/g, "").slice(0, 120);   if (res.status !== hc023ExpectedStatus || (hc023ExpectedCode !== null && hc023ActualCode !== hc023ExpectedCode)) {     console.log(`[HC-023 DIAG] 98-hc023-maintenance-readback expectedStatus=${hc023ExpectedStatus} actualStatus=${res.status} expectedCode=${hc023ExpectedCode ?? "<not-asserted>"} actualCode=${hc023Safe(hc023ActualCode) || "<none>"} traceId=${hc023Safe(hc023TraceId) || "<none>"}`);   }
const blocks = res.body.maintenance ?? [];
  const id = String(bru.getVar("hc023MaintenanceId") ?? bru.getEnvVar("hc023MaintenanceId"));
  const block = blocks.find(x => String(x.id) === id);
  if (!block) throw new Error("Amended HC-023 maintenance block is missing from inventory readback.");
  if (String(block.startDate) !== String(bru.getVar("hc023MaintenanceNewStartDate") ?? bru.getEnvVar("hc023MaintenanceNewStartDate"))) throw new Error("Amended HC-023 maintenance start date did not read back.");
  bru.setVar("hc023InventoryVersion", res.body.version);
}
