meta {
  name: 35-hc034-admin-dispute-resolve
  type: http
  seq: 40
}
post {
  url: {{baseUrl}}/api/v1/admin/care-homes/check-in-disputes/{{hc034CaseId}}/resolve
  body: json
  auth: bearer
}
auth:bearer {
  token: {{adminCareHomesSuperJwt}}
}
headers {
  Content-Type: application/json
}
body:json {
  { "effectiveCheckInOnUtc": "{{hc034EffectiveCheckInOnUtc}}", "evidence": "Signed facility log", "reason": "Family confirmation missing at facility check-out" }
}
assert {
  res.status: eq 200
  res.body.status: eq 2
  res.body.evidence: eq Signed facility log
  res.body.reason: eq Family confirmation missing at facility check-out
  res.body.effectiveCheckInOnUtc: isNotEmpty
}
