meta {
  name: 09-owner-list
  type: http
  seq: 12
}
get {
  url: {{baseUrl}}/api/v1/care-homes/booking-requests/mine
  body: none
  auth: bearer
}
auth:bearer {
  token: {{careHomeOwnerJwt}}
}
assert {
  res.status: eq 200
  res.body: isNotEmpty
}
script:post-response {
  const items = Array.isArray(res.body) ? res.body : (res.body.items ?? res.body.data ?? []);
  const first = items[0];
  const rawId = first && (first.id ?? first.Id);
  const id = rawId && typeof rawId === "object" ? (rawId.value ?? rawId.Value) : rawId;
  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(id ?? ""))) {
    throw new Error("The owner booking list did not return a booking GUID.");
  }
  bru.setVar("careHomeBookingId", id);
  console.log("Care-home owner booking fixture ID:", id);
}
