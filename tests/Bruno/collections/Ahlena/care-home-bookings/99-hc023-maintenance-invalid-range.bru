meta {
  name: 99-hc023-maintenance-invalid-range
  type: http
  seq: 99
}
put {
  url: {{baseUrl}}/api/v1/care-homes/inventory/mine/maintenance/{{hc023MaintenanceId}}
  body: json
  auth: bearer
}
auth:bearer {
  token: {{careHomeOwnerJwt}}
}
headers {
  Content-Type: application/json
}
body:json {
  { "expectedVersion": {{hc023InventoryVersion}}, "startDate": "{{hc023MaintenanceNewEndDate}}", "endDate": "{{hc023MaintenanceNewStartDate}}", "reason": "Invalid HC-023 range" }
}
assert {
  res.status: eq 400
  res.body.code: eq CareHomes.Inventory.InvalidRange
}
script:post-response {
  const hc023ExpectedStatus = 400;   const hc023ExpectedCode = "CareHomes.Inventory.InvalidRange";   const hc023Body = res.body && typeof res.body === "object" ? res.body : {};   const hc023ActualCode = typeof hc023Body.code === "string" ? hc023Body.code : "";   const hc023TraceId = typeof hc023Body.traceId === "string" ? hc023Body.traceId : "";   const hc023Safe = (value) => value.replace(/[^A-Za-z0-9._:-]/g, "").slice(0, 120);   if (res.status !== hc023ExpectedStatus || (hc023ExpectedCode !== null && hc023ActualCode !== hc023ExpectedCode)) {     console.log(`[HC-023 DIAG] 99-hc023-maintenance-invalid-range expectedStatus=${hc023ExpectedStatus} actualStatus=${res.status} expectedCode=${hc023ExpectedCode ?? "<not-asserted>"} actualCode=${hc023Safe(hc023ActualCode) || "<none>"} traceId=${hc023Safe(hc023TraceId) || "<none>"}`);   }
}
