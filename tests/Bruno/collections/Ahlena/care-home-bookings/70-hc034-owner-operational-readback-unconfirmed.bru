meta {
  name: 70-hc034-owner-operational-readback-unconfirmed
  type: http
  seq: 70
}
get {
  url: {{baseUrl}}/api/v1/care-homes/booking-requests/mine/{{hc034SharedBookingId}}/operational
  body: none
  auth: bearer
}
auth:bearer {
  token: {{careHomeOwnerJwt}}
}
assert {
  res.status: eq 200
  res.body.assignedRoomId: eq {{hc034SharedRoomId}}
  res.body.assignedBedId: eq {{hc034SharedBedId}}
  res.body.actualCheckInRecordedBy: isNotEmpty
  res.body.actualCheckOutRecordedBy: isNotEmpty
}
script:post-response {
  const body = res.body ?? {};
  if (body.familyCheckInConfirmedOnUtc !== null || body.familyCheckInConfirmedBy !== null) {
    throw new Error("The no-confirmation checkout fixture must retain null Family confirmation timestamp and actor.");
  }
}
