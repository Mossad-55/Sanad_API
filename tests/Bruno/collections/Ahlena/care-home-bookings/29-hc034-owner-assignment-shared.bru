meta {
  name: 29-hc034-owner-assignment-shared
  type: http
  seq: 34
}
post {
  url: {{baseUrl}}/api/v1/care-homes/booking-requests/mine/{{hc034SharedBookingId}}/assignment
  body: json
  auth: bearer
}
auth:bearer {
  token: {{careHomeOwnerJwt}}
}
headers {
  Content-Type: application/json
}
body:json {
  { "roomId": "{{hc034SharedRoomId}}", "bedId": "{{hc034SharedBedId}}" }
}
assert {
  res.status: eq 200
  res.body.assignedRoomId: eq {{hc034SharedRoomId}}
  res.body.assignedBedId: eq {{hc034SharedBedId}}
}
