meta {
  name: 104-hc023-maintenance-amend-unauthenticated
  type: http
  seq: 104
}
put {
  url: {{baseUrl}}/api/v1/care-homes/inventory/mine/maintenance/{{hc023MaintenanceId}}
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  { "expectedVersion": {{hc023InventoryVersion}}, "startDate": "{{hc023MaintenanceNewStartDate}}", "endDate": "{{hc023MaintenanceNewEndDate}}", "reason": "Unauthenticated HC-023 amend" }
}
assert {
  res.status: eq 401
}
script:post-response {
  const hc023ExpectedStatus = 401;   const hc023ExpectedCode = null;   const hc023Body = res.body && typeof res.body === "object" ? res.body : {};   const hc023ActualCode = typeof hc023Body.code === "string" ? hc023Body.code : "";   const hc023TraceId = typeof hc023Body.traceId === "string" ? hc023Body.traceId : "";   const hc023Safe = (value) => value.replace(/[^A-Za-z0-9._:-]/g, "").slice(0, 120);   if (res.status !== hc023ExpectedStatus || (hc023ExpectedCode !== null && hc023ActualCode !== hc023ExpectedCode)) {     console.log(`[HC-023 DIAG] 104-hc023-maintenance-amend-unauthenticated expectedStatus=${hc023ExpectedStatus} actualStatus=${res.status} expectedCode=${hc023ExpectedCode ?? "<not-asserted>"} actualCode=${hc023Safe(hc023ActualCode) || "<none>"} traceId=${hc023Safe(hc023TraceId) || "<none>"}`);   }
}
