meta {
  name: 16-logout-medical-caregiver
  type: http
  seq: 16
}
post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout
  body: none
  auth: bearer
}
headers {
  X-Device-Session-Id: {{caregiverCertificatesSessionId}}
}
auth:bearer {
  token: {{caregiverCertificatesJwt}}
}
assert {
  res.status: eq 204
}
