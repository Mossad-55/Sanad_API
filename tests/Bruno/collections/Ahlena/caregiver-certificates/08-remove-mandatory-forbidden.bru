meta {
  name: 08-remove-mandatory-forbidden
  type: http
  seq: 8
}
delete {
  url: {{baseUrl}}/api/v1/caregiver/certificates/{{caregiverPracticeCertificateId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{caregiverCertificatesJwt}}
}
assert {
  res.status: eq 409
  res.body.code: eq "Caregivers.Onboarding.InvalidCertificateOperation"
}
