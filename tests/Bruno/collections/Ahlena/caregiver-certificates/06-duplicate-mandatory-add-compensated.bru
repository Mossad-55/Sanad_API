meta {
  name: 06-duplicate-mandatory-add-compensated
  type: http
  seq: 6
}
post {
  url: {{baseUrl}}/api/v1/caregiver/certificates
  body: multipart-form
  auth: bearer
}
auth:bearer {
  token: {{caregiverCertificatesJwt}}
}
body:multipart-form {
  type: 1
  file: @file(service-icon-fixture.png) @contentType(image/png)
}
assert {
  res.status: eq 409
  res.body.code: eq "Caregivers.Onboarding.InvalidCertificateOperation"
}
