  seq: 7
}
put {
  url: {{baseUrl}}/api/v1/caregiver/certificates/11111111-1111-1111-1111-111111111111/file
  body: multipart-form
  auth: bearer
}
auth:bearer {
  token: {{caregiverCertificatesJwt}}
