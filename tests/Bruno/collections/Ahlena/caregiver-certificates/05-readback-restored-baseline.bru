meta {
  name: 05-readback-restored-baseline
  type: http
  seq: 5
}
get {
  url: {{baseUrl}}/api/v1/caregiver/profile
  body: none
  auth: bearer
}
auth:bearer {
  token: {{caregiverCertificatesJwt}}
}
assert {
  res.status: eq 200
}
script:post-response {
  const normalize = xs => xs.map(c => ({id:c.id.value ?? c.id,type:c.type,verificationStatus:c.verificationStatus,expiryDate:c.expiryDate})).sort((a,b)=>a.id.localeCompare(b.id));
  if (JSON.stringify(normalize(res.body.certificates ?? [])) !== bru.getVar("caregiverCertificatesBaseline")) throw new Error("Certificate profile did not restore exactly to baseline.");
  if (res.body.status !== 4 || res.body.availability !== 1) throw new Error("Certificate cleanup changed caregiver status/availability.");
}
