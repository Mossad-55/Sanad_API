meta {
  name: 12-login-viewer
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{viewerEmail}}",
    "password": "{{viewerPassword}}",
    "deviceName": "bruno-family-medication-mutations-viewer",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("familyMedicationMutationViewerJwt", res.body.accessToken);
}
