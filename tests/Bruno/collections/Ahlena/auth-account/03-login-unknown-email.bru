meta {
  name: 03-login-unknown-email
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "nobody@test.sanad.local",
    "password": "{{familyOwnerPassword}}",
    "deviceName": "bruno-acceptance",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq Identity.Login.InvalidCredentials
}
