meta {
  name: 02-login-wrong-password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{familyOwnerEmail}}",
    "password": "Wrong-1234!",
    "deviceName": "bruno-acceptance",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq Identity.Login.InvalidCredentials
}
