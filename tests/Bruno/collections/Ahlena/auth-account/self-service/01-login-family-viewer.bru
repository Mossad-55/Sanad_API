meta {
  name: 01-login-family-viewer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{viewerEmail}}",
    "password": "{{viewerPassword}}",
    "deviceName": "bruno-account-self-service",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isNotEmpty
}

script:post-response {
  bru.setVar("accountSelfServiceJwt", res.body.accessToken);
}
