meta {
  name: 18-login-caregiver-forbidden
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Assessment authorization coverage requires the guarded local Development API.");
}

body:json {
  { "email": "{{caregiverEmail}}", "password": "{{caregiverPassword}}", "deviceName": "bruno-assessment-role-check", "devicePlatform": 3, "appVersion": "1.0.0" }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("assessmentCaregiverJwt", res.body.accessToken);
}
