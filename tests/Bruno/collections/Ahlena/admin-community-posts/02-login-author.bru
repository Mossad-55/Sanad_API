meta {
  name: 02-login-author
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  { "email": "{{companionCaregiverEmail}}", "password": "{{companionCaregiverPassword}}", "deviceName": "bruno-admin-community-author", "devicePlatform": 3, "appVersion": "1.0.0" }
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("authorJwt", res.body.accessToken);
  bru.setVar("authorSessionId", res.body.deviceSessionId.value);
}
