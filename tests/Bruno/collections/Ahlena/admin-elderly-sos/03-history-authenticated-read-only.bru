meta {
  name: 03-history-authenticated-read-only
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/elderly/sos/0f000000-0000-4000-8000-000000000001/history
  body: none
  auth: bearer
}

headers {
  X-Correlation-ID: bruno-admin-sos-history
}

auth:bearer {
  token: {{adminSosSupportJwt}}
}

assert {
  res.status: eq 404
  res.body.code: eq Families.Sos.NotFound
}
