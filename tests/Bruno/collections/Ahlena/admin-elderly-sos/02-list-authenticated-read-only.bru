meta {
  name: 02-list-authenticated-read-only
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/elderly/sos?page=1&pageSize=20
  body: none
  auth: bearer
}

headers {
  X-Correlation-ID: bruno-admin-sos-list
}

auth:bearer {
  token: {{adminSosSupportJwt}}
}

assert {
  res.status: eq 200
  res.body.page: eq 1
  res.body.pageSize: eq 20
  res.body.totalCount: isNumber
  res.body.items: isArray
}
