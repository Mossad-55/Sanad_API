meta {
  name: 04-family-booking-detail-success
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/family/bookings/{{familyCheckoutBookingId}}
  body: none
  auth: bearer
}

headers {
  X-Device-Session-Id: {{familyBookingDeviceSessionId}}
}

auth:bearer {
  token: {{familyBookingJwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const id = res.body && (res.body.id ?? res.body.Id);
  const base = res.body && (res.body.baseCaregiverFee ?? res.body.BaseCaregiverFee);
  const feePercentage = res.body && (res.body.platformFeePercentage ?? res.body.PlatformFeePercentage);
  const fee = res.body && (res.body.platformFeeAmount ?? res.body.PlatformFeeAmount);
  const total = res.body && (res.body.totalPayableAmount ?? res.body.TotalPayableAmount);
  const currency = res.body && (res.body.currency ?? res.body.Currency);
  const address = res.body && (res.body.serviceAddress ?? res.body.ServiceAddress);
  const totalCents = typeof total === "number" ? Math.round(total * 100) : -1;
  const expectedCents = typeof base === "number" && typeof fee === "number" ? Math.round(base * 100) + Math.round(fee * 100) : -1;
  if (id !== bru.getVar("familyCheckoutBookingId") || address !== "Disposable local Bruno booking fixture" || typeof base !== "number" || base <= 0 || feePercentage !== 1 || typeof fee !== "number" || fee <= 0 || currency !== "EGP" || typeof total !== "number" || total <= 0 || totalCents !== expectedCents) throw new Error("The booking detail did not match the local checkout pricing response.");
}
