meta {
  name: 08-companion-pricing-update-success
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/caregiver/pricing/companion
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{caregiverPricingCompanionJwt}}
}

body:json {
  {
    "hourlyPrice": 81.25,
    "eightHourDayPrice": 501.25,
    "overnightPrice": 701.25
  }
}

assert {
  res.status: eq 200
  res.body.companionPricing.hourlyPrice: eq 81.25
  res.body.companionPricing.eightHourDayPrice: eq 501.25
  res.body.companionPricing.overnightPrice: eq 701.25
}
