meta {
  name: 12-family-reads-caregiver-availability
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/caregivers/{{caregiverId}}/availability
  body: none
  auth: bearer
}

auth:bearer {
  token: {{caregiverAvailabilityViewerJwt}}
}

assert {
  res.status: eq 200
}

docs {
  Uses a Family-access token and a real caregiverId. This read-only route supports Family caregiver selection.
}
