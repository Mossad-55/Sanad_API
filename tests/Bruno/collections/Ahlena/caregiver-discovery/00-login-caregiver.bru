meta {
  name: 00-login-caregiver
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  const baseUrl = bru.getEnvVar("baseUrl");
  const match = /^http:\/\/localhost:(\d+)\/?$/.exec(baseUrl || "");
  const port = match ? Number(match[1]) : NaN;
  if (!match || !Number.isInteger(port) || port < 1 || port > 65535 || port === 5235 || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Caregiver discovery coverage requires an explicit non-5235 localhost Development API port.");
}

body:json {
  {
    "email": "{{caregiverEmail}}",
    "password": "{{caregiverPassword}}",
    "deviceName": "bruno-caregiver-discovery",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("caregiverDiscoveryJwt", res.body.accessToken);
  bru.setVar("caregiverDiscoverySessionId", res.body.deviceSessionId.value);
}
