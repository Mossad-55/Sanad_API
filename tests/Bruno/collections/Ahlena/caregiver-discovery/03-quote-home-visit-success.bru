meta {
  name: 03-quote-home-visit-success
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/caregivers/{{caregiverDiscoveryTargetId}}/quote?shiftType=1&startTime=10:00&endTime=12:00
  body: none
  auth: bearer
}

auth:bearer {
  token: {{caregiverDiscoveryJwt}}
}

script:post-response {
  const returnedCaregiverId = res.body && (res.body.caregiverId ?? res.body.CaregiverId);
  if (returnedCaregiverId !== bru.getVar("caregiverDiscoveryTargetId")) throw new Error("The caregiver quote returned a different caregiver than the requested fixture.");
}

assert {
  res.status: eq 200
  res.body.caregiverId: isNotEmpty
  res.body.baseCaregiverFee: gt 0
  res.body.platformFeePercentage: eq 1
  res.body.platformFeeAmount: gt 0
  res.body.taxRatePercentage: eq 0
  res.body.taxAmount: eq 0
  res.body.platformChargeRuleVersion: gt 0
  res.body.totalPayableAmount: gt 0
  res.body.currency: eq EGP
}
