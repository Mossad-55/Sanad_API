meta {
  name: 10-password-change-wrong-current
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/auth/password/change
  body: json
  auth: bearer
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Auth coverage requires the guarded local Development API.");
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "Definitely-Wrong-1234!",
    "newPassword": "New-Test-1234!"
  }
}

auth:bearer {
  token: {{authSessionPasswordAccessToken}}
}

assert {
  res.status: eq 401
  res.body.code: eq Identity.Password.InvalidCurrentPassword
}
