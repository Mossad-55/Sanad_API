meta {
  name: 02-verify-unknown-request
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/verification/verify
  body: json
  auth: none
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Auth coverage requires the guarded local Development API.");
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "verificationRequestId": "0f000000-0000-4000-8000-000000000091",
    "code": "123456"
  }
}

assert {
  res.status: eq 401
}
