meta {
  name: 07-login-support-admin
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Auth coverage requires the guarded local Development API.");
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{supportAdminEmail}}",
    "password": "{{supportAdminPassword}}",
    "deviceName": "bruno-auth-session-password",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isNotEmpty
  res.body.refreshToken: isNotEmpty
  res.body.deviceSessionId.value: isNotEmpty
}

script:post-response {
  bru.setVar("authSessionPasswordAccessToken", res.body.accessToken);
  bru.setVar("authSessionPasswordRefreshToken", res.body.refreshToken);
  bru.setVar("authSessionPasswordDeviceSessionId", res.body.deviceSessionId.value);
}
