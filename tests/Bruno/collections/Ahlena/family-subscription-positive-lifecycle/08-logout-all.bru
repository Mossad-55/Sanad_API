meta {
  name: 08-logout-all
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout-all
  body: none
  auth: bearer
}

headers {
  X-Device-Session-Id: {{positivePlanChangeDeviceSessionId}}
}

auth:bearer {
  token: {{positivePlanChangeJwt}}
}

assert {
  res.status: eq 204
}
