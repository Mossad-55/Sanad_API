meta {
  name: 01-login-subscription-free-owner
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{subscriptionFreeEmail}}",
    "password": "{{familyOwnerPassword}}",
    "deviceName": "bruno-subscription-positive-enrollment",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("positiveEnrollmentJwt", res.body.accessToken);
  bru.setVar("positiveEnrollmentDeviceSessionId", res.body.deviceSessionId.value);
}
