meta {
  name: 11a-owner-read-license-version
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/care-homes/facilities/mine
  auth: bearer
}

auth:bearer {
  token: {{adminCareHomesOwnerJwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status !== 200 || !res.body) throw new Error("Expected license replacement version readback.");
  bru.setVar("adminCareHomeOwnerVersion", res.body.version);
}
