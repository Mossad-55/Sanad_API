meta {
  name: 04-detail-missing
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/admin/care-homes/00000000-0000-0000-0000-000000000000
  auth: bearer
}

auth:bearer {
  token: {{adminCareHomesSuperJwt}}
}

assert {
  res.status: eq 404
  res.body.code: eq CareHomes.Admin.ApplicationNotFound
}
