meta {
  name: 10-login-content-admin
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}",
    "deviceName": "bruno-admin-care-homes-content",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("adminCareHomesContentJwt", res.body.accessToken);
  bru.setVar("hc034ContentAdminDeviceSessionId", res.body.deviceSessionId.value);
}
