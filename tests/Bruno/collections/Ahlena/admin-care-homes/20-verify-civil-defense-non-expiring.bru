meta {
  name: 20-verify-civil-defense-non-expiring
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/api/v1/admin/care-homes/{{adminCareHomeId}}/documents/{{adminCareHomeDocument4}}/verify
  body: json
  auth: bearer
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:55819" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Care home document review requires the guarded main-worktree Development API.");
}

auth:bearer {
  token: {{adminCareHomesSuperJwt}}
}

body:json {
  {
    "expectedVersion": {{adminCareHomeVersion}},
    "expiryDate": null,
    "confirmNonExpiring": true
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status !== 200 || !res.body) throw new Error("Expected civil-defense verification response.");
  const document = res.body.documents.find(item => item.id === bru.getVar("adminCareHomeDocument4"));
  if (!document || document.status !== 2 || !document.verifiedNonExpiring) throw new Error("Expected explicit non-expiring civil-defense verification.");
  bru.setVar("adminCareHomeVersion", res.body.version);
}
