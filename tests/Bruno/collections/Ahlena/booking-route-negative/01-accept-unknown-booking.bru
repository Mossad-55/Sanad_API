meta {
  name: 01-accept-unknown-booking
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/caregiver/bookings/00000000-0000-0000-0000-000000000000/accept
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bookingCaregiverJwt}}
}

assert {
  res.status: eq 404
  res.body.code: eq Bookings.NotFound
}
