meta {
  name: 01-submit-unauthenticated
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/support/contact
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Support Contact requires guarded local Development.");
}

body:json {
  { "subject": "Bruno auth probe", "message": "Unauthenticated support request probe." }
}

assert {
  res.status: eq 401
}
