meta {
  name: 10-update-disposable-draft
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/v1/admin/legal-documents/{{adminLegalDocumentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminLegalDocumentsJwt}}
}

headers {
  Content-Type: application/json
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Admin legal-document mutations require the guarded local Development API.");
}

body:json {
  {
    "sections": [
      {
        "sectionType": 1,
        "displayOrder": 1,
        "arabicTitle": "شروط محدثة",
        "englishTitle": "Updated disposable terms",
        "arabicDescription": "تم تحديث المسودة محلياً.",
        "englishDescription": "The local draft was updated.",
        "arabicBullets": null,
        "englishBullets": null
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.id.value: eq {{adminLegalDocumentId}}
  res.body.status: eq 1
  res.body.sections: isArray
}
