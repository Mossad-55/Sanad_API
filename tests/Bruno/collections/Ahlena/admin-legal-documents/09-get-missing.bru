meta {
  name: 09-get-missing
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/admin/legal-documents/11111111-1111-4111-8111-111111111111
  auth: bearer
}

auth:bearer {
  token: {{adminLegalDocumentsJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Admin legal-document coverage requires the guarded local Development API.");
}

assert {
  res.status: eq 404
  res.body.code: eq Cms.Legal.NotFound
}
