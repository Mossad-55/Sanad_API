meta {
  name: 03-list-support-admin-forbidden
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/legal-documents
  auth: bearer
}

auth:bearer {
  token: {{supportAdminLegalDocumentsJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Admin legal-document authorization coverage requires the guarded local Development API.");
}

assert {
  res.status: eq 403
}
