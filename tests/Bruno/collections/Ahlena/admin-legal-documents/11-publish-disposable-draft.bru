meta {
  name: 11-publish-disposable-draft
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/admin/legal-documents/{{adminLegalDocumentId}}/publish
  auth: bearer
}

auth:bearer {
  token: {{adminLegalDocumentsJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Admin legal-document mutations require the guarded local Development API.");
}

assert {
  res.status: eq 200
  res.body.id.value: eq {{adminLegalDocumentId}}
  res.body.status: eq 2
  res.body.publishedOnUtc: isString
}
