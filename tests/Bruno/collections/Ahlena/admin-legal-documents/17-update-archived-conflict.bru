meta {
  name: 17-update-archived-conflict
  type: http
  seq: 17
}

put {
  url: {{baseUrl}}/api/v1/admin/legal-documents/{{adminLegalDocumentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminLegalDocumentsJwt}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sections": [
      {
        "sectionType": 1,
        "displayOrder": 1,
        "arabicTitle": "محاولة تعديل مؤرشف",
        "englishTitle": "Archived mutation attempt",
        "arabicDescription": "يجب رفض التعديل.",
        "englishDescription": "Archived content is immutable.",
        "arabicBullets": null,
        "englishBullets": null
      }
    ]
  }
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Admin legal-document mutations require the guarded local Development API.");
}

assert {
  res.status: eq 409
  res.body.code: eq Cms.Legal.PublishedDocumentImmutable
}
