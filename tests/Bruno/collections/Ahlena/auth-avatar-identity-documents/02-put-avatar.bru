meta {
  name: 02-put-avatar
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/auth/avatar
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{authImageOwnerJwt}}
}

body:multipart-form {
  file: @file(disposable-upload-fixture.png) @contentType(image/png)
}

assert {
  res.status: eq 204
}
