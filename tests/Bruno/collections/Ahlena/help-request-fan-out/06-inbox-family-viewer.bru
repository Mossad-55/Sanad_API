meta {
  name: 06-inbox-family-viewer
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/notifications?pageSize=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{helpRequestFamilyViewerJwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const match = (res.body.items || []).some(item =>
    item.type === "HelpRequestCreated" &&
    String(item.destinationEntityId).toLowerCase() === String(bru.getVar("helpRequestFanoutId")).toLowerCase());
  if (!match) throw new Error("Linked Family viewer did not receive the help-request notification.");
}
