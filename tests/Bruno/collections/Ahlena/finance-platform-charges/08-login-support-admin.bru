meta {
  name: 08-login-support-admin
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{supportAdminEmail}}",
    "password": "{{supportAdminPassword}}",
    "deviceName": "bruno-finance-support-admin",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("financeSupportAdminJwt", res.body.accessToken);
}
