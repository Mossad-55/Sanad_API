meta {
  name: 00-login-owner
  type: http
  seq: -1
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  { "email": "{{familyOwnerEmail}}", "password": "{{familyOwnerPassword}}", "deviceName": "bruno-family-booking-reviews", "devicePlatform": 3, "appVersion": "1.0.0" }
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("familyJwt", res.body.accessToken);
  bru.setVar("familySessionId", res.body.deviceSessionId.value);
}
