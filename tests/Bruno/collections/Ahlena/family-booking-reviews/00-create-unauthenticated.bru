meta {
  name: 00-create-unauthenticated
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/v1/family/bookings/00000000-0000-4000-8000-000000000001/review
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "rating": 5, "comment": "Fixture-only unauthenticated request" }
}

assert {
  res.status: eq 401
}
