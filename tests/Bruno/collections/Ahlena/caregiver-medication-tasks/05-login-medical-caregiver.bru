meta {
  name: 05-login-medical-caregiver
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "{{caregiverEmail}}", "password": "{{caregiverPassword}}", "deviceName": "bruno-caregiver-medication-tasks", "devicePlatform": 3, "appVersion": "1.0.0" }
}

script:post-response {
  if (!res.body.accessToken) throw new Error("Medical caregiver login did not return an access token.");
  bru.setVar("caregiverMedicationCaregiverJwt", res.body.accessToken);
}

assert {
  res.status: eq 200
}
