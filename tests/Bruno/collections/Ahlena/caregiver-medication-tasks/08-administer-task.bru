meta {
  name: 08-administer-task
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/caregivers/{{caregiverMedicationCaregiverId}}/medication-tasks/{{caregiverMedicationAdministerTaskId}}/administer
  body: none
  auth: bearer
}

auth:bearer {
  token: {{caregiverMedicationCaregiverJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Medication writes require the guarded local Development API.");
}

assert {
  res.status: eq 200
  res.body.status: eq 2
}
