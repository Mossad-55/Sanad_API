meta {
  name: 13-bootstrap-conflict
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/family
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerJwt}}
}

headers {
  Content-Type: application/json
}

body:json {
  {"name":"Duplicate family"}
}

assert {
  res.status: eq 409
  res.body.code: eq Families.Family.AlreadyExists
}
