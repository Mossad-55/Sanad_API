meta {
  name: 29-decline-unknown-token
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/api/v1/family/invitations/decline
  body: json
  auth: bearer
}

auth:bearer {
  token: {{inviteeFamilyJwt}}
}

headers {
  Content-Type: application/json
}

body:json {
  {"token":"not-a-real-token"}
}

assert {
  res.status: eq 404
  res.body.code: eq Families.Invitation.NotFound
}
