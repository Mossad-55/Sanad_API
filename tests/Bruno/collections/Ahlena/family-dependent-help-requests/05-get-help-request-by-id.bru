meta {
  name: 05-get-help-request-by-id
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/family/dependents/{{familyHelpDependentId}}/help-requests/{{familyHelpRequestId}}
  auth: bearer
}

auth:bearer {
  token: {{familyHelpJwt}}
}

assert {
  res.status: eq 200
  res.body.status: eq Pending
}
