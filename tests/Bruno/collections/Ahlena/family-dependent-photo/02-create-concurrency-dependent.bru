meta {
  name: 02-create-concurrency-dependent
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/v1/family/dependents
  body: multipartForm
  auth: bearer
}
auth:bearer {
  token: {{photoOwnerJwt}}
}
body:multipart-form {
  arabicFullName: مرافق اختبار التزامن الثاني
  englishFullName: HC032 Concurrent Elderly B
  phoneNumber: {{concurrencyDependentPhone}}
  gender: 2
  relationshipType: 8
  dateOfBirth: 1949-05-14
  detailedAddress: Disposable concurrency fixture
  healthNotes: HC032 isolated test identity
}
assert {
  res.status: eq 201
  res.body.englishFullName: eq HC032 Concurrent Elderly B
}
script:pre-request {
  bru.setVar("concurrencyDependentPhone", "+201" + String(Date.now()).slice(-9));
}
script:post-response {
  const id = res.body.id && (res.body.id.value || res.body.id);
  if (!id) throw new Error("Second concurrency dependent response did not contain an ID.");
  bru.setVar("careHomeConcurrentElderlyB", id);
}
