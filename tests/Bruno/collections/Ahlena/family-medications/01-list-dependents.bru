meta {
  name: 01-list-dependents
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/family/dependents
  body: none
  auth: bearer
}

auth:bearer {
  token: {{familyMedicationJwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const dependents = Array.isArray(res.body) ? res.body : (res.body.items || res.body.results || []);
  const id = dependents.length && typeof dependents[0].id === "object" ? dependents[0].id.value : dependents.length ? dependents[0].id : null;
  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(id))) throw new Error("Expected a seeded Family dependent GUID.");
  bru.setVar("familyMedicationDependentId", id);
}
