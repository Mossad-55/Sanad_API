meta {
  name: 27-detail-draft
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/api/v1/admin/wellness-tips/{{wellnessTipId}}
  auth: bearer
}

auth:bearer {
  token: {{wellnessTipsAdminJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Wellness tips lifecycle reads require the guarded local Development API.");
}

assert {
  res.status: eq 200
  res.body.status: eq 1
  res.body.id: eq {{wellnessTipId}}
  res.body.imagePath: eq {{wellnessTipOriginalImagePath}}
}
