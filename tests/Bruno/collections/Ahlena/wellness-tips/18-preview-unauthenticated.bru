meta {
  name: 18-preview-unauthenticated
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/v1/admin/wellness-tips/00000000-0000-0000-0000-000000000000/preview
  auth: none
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Wellness tips auth coverage requires the guarded local Development API.");
}

assert {
  res.status: eq 401
}
