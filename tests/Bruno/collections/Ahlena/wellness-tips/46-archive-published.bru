meta {
  name: 46-archive-published
  type: http
  seq: 46
}

post {
  url: {{baseUrl}}/api/v1/admin/wellness-tips/{{wellnessTipId}}/archive
  auth: bearer
}

auth:bearer {
  token: {{wellnessTipsAdminJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Wellness tips mutations require the guarded local Development API.");
}

assert {
  res.status: eq 200
  res.body.status: eq 3
  res.body.imagePath: eq {{wellnessTipReplacementImagePath}}
}
