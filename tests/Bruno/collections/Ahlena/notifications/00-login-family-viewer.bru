meta {
  name: 00-login-family-viewer
  type: http
  seq: 0
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Notification inbox scout requires the guarded local Development API.");
}
body:json {
  { "email": "{{viewerEmail}}", "password": "{{viewerPassword}}", "deviceName": "bruno-notification-inbox-scout", "devicePlatform": 3, "appVersion": "1.0.0" }
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("jwt", res.body.accessToken);
  bru.setVar("notificationScoutSessionId", res.body.deviceSessionId.value);
}
