meta {
  name: 01-list-authenticated-read-only
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/notifications?pageSize=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.body;
  if (!Array.isArray(body.items) || !("nextCursor" in body) || typeof body.unreadCount !== "number") {
    throw new Error("Notification list response must include items, nextCursor, and unreadCount");
  }
  const items = res.body.items ?? [];
  const readItems = items.filter(item => item.readOnUtc !== null);
  console.log("Notification inbox scout items/read/unread:", items.length, readItems.length, res.body.unreadCount);
  if (readItems.length > 0) {
    bru.setVar("notificationReadCandidateId", readItems[0].id);
    bru.setVar("notificationReadCandidateTimestamp", readItems[0].readOnUtc);
  }
}
