meta {
  name: 04-update-faq
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/admin/help-center/faqs/{{adminHelpFaqId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminHelpCenterJwt}}
}

headers {
  Content-Type: application/json
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Help Center mutations require the guarded local Development API.");
}

body:json {
  {
    "audience": 1,
    "arabicQuestion": "سؤال Bruno محدث {{helpCenterRun}}",
    "englishQuestion": "Updated Bruno help FAQ {{helpCenterRun}}",
    "arabicAnswer": "إجابة محدثة في قاعدة البيانات المحلية.",
    "englishAnswer": "Updated disposable local database FAQ answer.",
    "displayOrder": 901,
    "isActive": false
  }
}

assert {
  res.status: eq 200
}
