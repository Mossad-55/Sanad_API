meta {
  name: 14-login-support-admin
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Help Center authorization coverage requires the guarded local Development API.");
}

body:json {
  {
    "email": "{{supportAdminEmail}}",
    "password": "{{supportAdminPassword}}",
    "deviceName": "bruno-help-center-support-role",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("helpCenterSupportJwt", res.body.accessToken);
}
