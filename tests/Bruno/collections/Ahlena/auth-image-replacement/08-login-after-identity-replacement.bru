meta {
  name: 08-login-after-identity-replacement
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{familyOwnerEmail}}",
    "password": "{{familyOwnerPassword}}",
    "deviceName": "bruno-auth-image-replacement-after-reset",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("imageReplacementJwtAfterReset", res.body.accessToken);
  if (res.body.deviceSessionId !== null) throw new Error("Identity replacement must require re-verification instead of issuing a normal device session.");
}
