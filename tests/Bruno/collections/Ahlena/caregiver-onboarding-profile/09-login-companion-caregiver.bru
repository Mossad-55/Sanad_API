meta {
  name: 09-login-companion-caregiver
  type: http
  seq: 9
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  { "email": "{{companionCaregiverEmail}}", "password": "{{companionCaregiverPassword}}", "deviceName": "bruno-caregiver-onboarding-companion", "devicePlatform": 3, "appVersion": "1.0.0" }
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("onboardingCompanionJwt", res.body.accessToken);
}
