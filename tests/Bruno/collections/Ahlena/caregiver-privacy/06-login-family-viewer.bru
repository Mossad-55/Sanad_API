meta {
  name: 06-login-family-viewer
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Caregiver privacy coverage requires the guarded local Development API.");
}

body:json {
  {
    "email": "{{viewerEmail}}",
    "password": "{{viewerPassword}}",
    "deviceName": "bruno-caregiver-privacy-viewer",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("caregiverPrivacyViewerJwt", res.body.accessToken);
  bru.setVar("caregiverPrivacyViewerSessionId", res.body.deviceSessionId.value);
}
