meta {
  name: 05-logout-owner
  type: http
  seq: 5
  tags: [
    enrollment-negative
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout
  body: none
  auth: bearer
}

headers {
  X-Device-Session-Id: {{enrollmentOwnerDeviceSessionId}}
}

auth:bearer {
  token: {{enrollmentOwnerJwt}}
}

assert {
  res.status: eq 204
}
