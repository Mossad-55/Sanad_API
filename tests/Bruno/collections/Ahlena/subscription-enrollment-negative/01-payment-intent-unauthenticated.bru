meta {
  name: 01-payment-intent-unauthenticated
  type: http
  seq: 1
  tags: [
    enrollment-negative
  ]
}

post {
  url: {{baseUrl}}/api/v1/family/subscriptions/payment-intent
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "planVersionId": "00000000-0000-0000-0000-000000000000",
    "method": 1,
    "billing": {
      "firstName": "Ahmed",
      "lastName": "Ali",
      "email": "ahmed@example.com",
      "phoneNumber": "+201012345678"
    }
  }
}

assert {
  res.status: eq 401
}
