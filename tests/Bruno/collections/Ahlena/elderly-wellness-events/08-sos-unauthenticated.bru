meta {
  name: 08-sos-unauthenticated
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/elderly/sos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: bruno-elderly-wellness-sos-unauthenticated
}

body:json {
  {
    "locationConsentGranted": true,
    "latitude": null,
    "longitude": null
  }
}

assert {
  res.status: eq 401
}
