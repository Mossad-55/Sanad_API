meta {
  name: 04-list-upcoming-pick-confirmed
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/caregiver/bookings?tab=Upcoming
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const items = Array.isArray(res.body)
    ? res.body
    : (res.body && (res.body.items || res.body.results)) || [];
  const statusOf = (it) => it.status ?? it.Status;
  const idOf = (it) => it.id ?? it.Id ?? it.bookingId ?? it.BookingId;
  const isConfirmed = (s) => s === 3 || s === "Confirmed" || s === "confirmed";
  // The caregiver Upcoming tab is PendingCaregiverApproval + Confirmed only;
  // the seed carries no PendingCaregiverApproval booking, so Confirmed is the
  // only guaranteed upcoming target for the seeded caregiver.
  const confirmed = items.find((i) => isConfirmed(statusOf(i)));
  bru.setVar("cgConfirmedBookingId", confirmed ? idOf(confirmed) : "");
  console.log("upcoming:", items.length,
    "| confirmed target:", bru.getVar("cgConfirmedBookingId") || "NONE");
  if (!confirmed) {
    console.log("NOTE: no Confirmed upcoming booking for the seeded caregiver - steps 06/07/08 and the caregiver-cancel-lifecycle folder will 404 on an empty id; reseed the dev database, then re-run.");
  }
}
