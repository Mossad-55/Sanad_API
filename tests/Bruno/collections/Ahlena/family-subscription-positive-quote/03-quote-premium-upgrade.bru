meta {
  name: 03-quote-premium-upgrade
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/family/subscriptions/plan-change/quote
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Device-Session-Id: {{positiveQuoteOwnerDeviceSessionId}}
}

auth:bearer {
  token: {{positiveQuoteOwnerJwt}}
}

body:json {
  {
    "planVersionId": "{{positiveQuotePremiumPlanId}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  const quote = res.body;
  if (!quote || Number(quote.taxRatePercentage) !== 15 || Number(quote.platformFeeRatePercentage) < 0 || Number(quote.platformFeeAmount) < 0 || Number(quote.platformChargeRuleVersion) <= 0 || Number(quote.totalPayable) <= 0) {
    throw new Error("Premium upgrade quote must include the active Finance fee/tax snapshot and a positive total.");
  }
}
