meta {
  name: 06-viewer-forbidden
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/family/dependents/{{familyActivitiesDependentId}}/activities
  body: none
  auth: bearer
}

auth:bearer {
  token: {{familyActivitiesViewerJwt}}
}

assert {
  res.status: eq 403
  res.body.code: eq Families.Family.AccessDenied
}
