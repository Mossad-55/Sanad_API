meta {
  name: 05-reply-unauthenticated
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/community/comments/00000000-0000-4000-8000-000000000001/replies
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "contentArabic": "\u0631\u062F \u063A\u064A\u0631 \u0645\u0635\u0631\u062D \u0628\u0647", "contentEnglish": "Fixture-only unauthenticated request" }
}

assert {
  res.status: eq 401
}
