meta {
  name: 00-create-unauthenticated
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/v1/community/posts/00000000-0000-4000-8000-000000000001/comments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "contentArabic": "\u062A\u0639\u0644\u064A\u0642 \u063A\u064A\u0631 \u0645\u0635\u0631\u062D \u0628\u0647", "contentEnglish": "Fixture-only unauthenticated request" }
}

assert {
  res.status: eq 401
}
