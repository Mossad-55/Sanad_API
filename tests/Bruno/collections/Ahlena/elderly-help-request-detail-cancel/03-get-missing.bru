meta {
  name: 03-get-missing
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/elderly/help-requests/00000000-0000-4000-8000-000000000001
  body: none
  auth: bearer
}

auth:bearer {
  token: {{elderlyHelpRequestJwt}}
}

assert {
  res.status: eq 404
  res.body.code: eq Families.HelpRequest.NotFound
}
