meta {
  name: 01-create-disposable-request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/elderly/help-requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{elderlyHelpRequestJwt}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{elderlyHelpRequestKey}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Help-request writes require guarded local Development only.");
  bru.setVar("elderlyHelpRequestKey", "bruno-help-request-detail-cancel-" + Date.now());
}

body:json {
  {
    "actorKey": "self",
    "actionKey": "need",
    "needKey": "water",
    "qualifierKey": "now",
    "customText": null
  }
}

assert {
  res.status: eq 200
  res.body.id: isNotEmpty
}

script:post-response {
  bru.setVar("elderlyHelpRequestId", res.body.id);
}
