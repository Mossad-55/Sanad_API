meta {
  name: 09-delete-as-viewer
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/api/v1/family
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtViewer}}
}

body:json {
  {
    "reason": "acceptance",
    "optionalMessage": null,
    "acknowledgement": false
  }
}

assert {
  res.status: eq 403
  res.body.code: eq Families.Family.NotOwner
}
