meta {
  name: 01-submit-valid-authenticated
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/feedback/app-rating
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "rating": 5, "comment": "Fixture feedback", "deviceInfo": "bruno", "appVersion": "test" }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
