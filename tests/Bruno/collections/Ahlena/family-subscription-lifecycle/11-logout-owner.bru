meta {
  name: 11-logout-owner
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout
  body: none
  auth: bearer
}

headers {
  X-Device-Session-Id: {{familySubscriptionOwnerDeviceSessionId}}
}

auth:bearer {
  token: {{familySubscriptionOwnerJwt}}
}

assert {
  res.status: eq 204
}
