meta {
  name: 04-create-missing-file-validation
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/admin/splash-screens
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{adminSplashScreensJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Admin splash screen mutations require the guarded local Development API.");
}

body:multipart-form {
  internalName: bruno-missing-file-{{adminSplashRun}}
  arabicTitle: اختبار شاشة البداية
  englishTitle: Missing file validation
  arabicDescription: وصف تجريبي
  englishDescription: Disposable validation request
  arabicButtonText: التالي
  englishButtonText: Next
  backgroundColor: #1A73E8
  displayOrder: 900
}

assert {
  res.status: eq 400
}
