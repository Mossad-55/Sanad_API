meta {
  name: 01-login-superadmin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Admin caregivers coverage requires the guarded local Development API.");
}

body:json {
  {
    "email": "elderly.welcome.admin@test.sanad.local",
    "password": "Welcome-Admin-1234!",
    "deviceName": "bruno-admin-caregivers-super",
    "devicePlatform": 3,
    "appVersion": "1.0.0"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("adminCaregiversSuperJwt", res.body.accessToken);
}
