meta {
  name: 17-cleanup-superadmin-session
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions/logout-all
  body: none
  auth: bearer
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Fixture cleanup must target the guarded local Development API.");
  if (!bru.getVar("adminCaregiversSuperJwt")) throw new Error("Run the SuperAdmin login before fixture cleanup.");
}

auth:bearer {
  token: {{adminCaregiversSuperJwt}}
}

assert {
  res.status: eq 204
}
