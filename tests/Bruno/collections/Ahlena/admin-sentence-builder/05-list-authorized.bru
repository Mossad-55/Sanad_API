meta {
  name: 05-list-authorized
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/admin/sentence-builder/catalog?page=1&pageSize=50&category=3&active=true
  auth: bearer
}

auth:bearer {
  token: {{adminSentenceBuilderJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Sentence Builder coverage requires the guarded local Development API.");
}

assert {
  res.status: eq 200
}

script:post-response {
  if (!Array.isArray(res.body.items)) throw new Error("Authorized list response did not include items.");
  if (res.body.page !== 1 || res.body.pageSize !== 50 || typeof res.body.totalCount !== "number") throw new Error("Authorized list response omitted pagination metadata.");
}
