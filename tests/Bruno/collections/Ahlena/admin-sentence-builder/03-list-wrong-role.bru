meta {
  name: 03-list-wrong-role
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/sentence-builder/catalog?page=1&pageSize=50
  auth: bearer
}

auth:bearer {
  token: {{adminSentenceBuilderViewerJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Sentence Builder role coverage requires the guarded local Development API.");
}

assert {
  res.status: eq 403
}
