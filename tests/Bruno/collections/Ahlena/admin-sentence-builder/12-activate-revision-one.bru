meta {
  name: 12-activate-revision-one
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/admin/sentence-builder/catalog/{{adminSentenceBuilderRevisionOneId}}/activate
  auth: bearer
}

auth:bearer {
  token: {{adminSentenceBuilderJwt}}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Sentence Builder lifecycle mutations require the guarded local Development API.");
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.body.revisionId !== bru.getVar("adminSentenceBuilderRevisionOneId") || res.body.version !== 1 || res.body.isActive !== true || res.body.arabicLabel !== "مساعدة تجريبية" || res.body.englishLabel !== "Disposable help") throw new Error("Activate did not restore the original immutable revision.");
}
