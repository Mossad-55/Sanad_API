meta {
  name: 01-list-unauthenticated
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/sentence-builder/catalog?page=1&pageSize=50&category=3&active=true
  body: none
  auth: none
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Sentence Builder auth coverage requires the guarded local Development API.");
}

assert {
  res.status: eq 401
}
