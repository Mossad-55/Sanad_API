meta {
  name: 07-create-success
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/admin/sentence-builder/catalog
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminSentenceBuilderJwt}}
}

headers {
  Content-Type: application/json
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Sentence Builder mutations require the guarded local Development API.");
}

body:json {
  {
    "stableKey": "{{adminSentenceBuilderKey}}",
    "category": 3,
    "arabicLabel": "مساعدة تجريبية",
    "englishLabel": "Disposable help",
    "displayOrder": 900
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.body.stableKey !== bru.getVar("adminSentenceBuilderKey") || res.body.category !== 3 || res.body.arabicLabel !== "مساعدة تجريبية" || res.body.englishLabel !== "Disposable help" || res.body.displayOrder !== 900 || res.body.version !== 1 || res.body.isActive !== true) throw new Error("Initial Sentence Builder revision did not match the immutable test payload.");
  bru.setVar("adminSentenceBuilderEntryId", res.body.entryId);
  bru.setVar("adminSentenceBuilderRevisionOneId", res.body.revisionId);
}
