meta {
  name: 08-put-unauthenticated
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/family/dependents/{{familyEmergencyDependentId}}/emergency-contact
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"name": "Anonymous", "relationship": "Friend", "phoneNumber": "+201000000000"}
}

assert {
  res.status: eq 401
}
