meta {
  name: 13-companion-readback-after-invalid
  type: http
  seq: 13
}
get {
  url: {{baseUrl}}/api/v1/caregiver/profile
  body: none
  auth: bearer
}
auth:bearer {
  token: {{scheduleCompanionJwt}}
}
assert {
  res.status: eq 200
}
script:post-response {
  const windows = JSON.stringify((res.body.companionSchedule?.windows ?? []).map(x => ({bookingType:x.bookingType,dayOfWeek:x.dayOfWeek,startTime:x.startTime.slice(0,5),endTime:x.endTime.slice(0,5)})));
  if (windows !== bru.getVar("scheduleCompanionWindows")) throw new Error("Rejected companion update changed the baseline.");
}
