meta {
  name: 06-login-companion
  type: http
  seq: 6
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:5235" || bru.getEnvVar("appEnvironment") !== "Development") throw new Error("Caregiver schedule coverage requires the guarded local Development API.");
}
body:json {
  { "email": "{{companionCaregiverEmail}}", "password": "{{caregiverPassword}}", "deviceName": "bruno-caregiver-schedules-companion", "devicePlatform": 3, "appVersion": "1.0.0" }
}
assert {
  res.status: eq 200
}
script:post-response {
  bru.setVar("scheduleCompanionJwt", res.body.accessToken);
  bru.setVar("scheduleCompanionSessionId", res.body.deviceSessionId.value);
}
