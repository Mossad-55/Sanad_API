meta {
  name: 07-stale-draft-conflict
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/care-homes/facilities/mine/profile
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "expectedVersion": {{careHomeFacilityStaleVersion}},
    "draft": {
      "arabicName": "دار أخرى",
      "englishName": "Other House",
      "arabicDescription": "وصف",
      "englishDescription": "Description",
      "contactName": "Test Contact",
      "contactPhone": "+201000000011",
      "governorate": "Cairo",
      "city": "Nasr City",
      "area": "District 1",
      "address": "1 Example Street",
      "arabicAdmissionConditions": "الشروط",
      "englishAdmissionConditions": "Conditions",
      "amenities": [],
      "medicalServices": []
    }
  }
}

auth:bearer {
  token: {{careHomeOwnerJwt}}
}

assert {
  res.status: eq 409
  res.body.code: eq CareHomes.Facility.Conflict
}
