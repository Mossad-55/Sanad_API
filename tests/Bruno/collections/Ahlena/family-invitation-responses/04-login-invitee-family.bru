meta {
  name: 04-login-invitee-family
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"email":"{{caregiverEmail}}","password":"{{caregiverPassword}}","deviceName":"family-invitation-accept","devicePlatform":3,"appVersion":"1.0.0"}
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("invitationInviteeJwt", res.body.accessToken);
}
