meta {
  name: 01-create-viewer-invitation-for-decline
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/family/invitations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerJwt}}
}

headers {
  Content-Type: application/json
}

body:json {
  {"email":"{{viewerEmail}}","role":3,"relationshipType":6}
}

assert {
  res.status: eq 201
  res.body.invitedEmail: eq {{viewerEmail}}
}
